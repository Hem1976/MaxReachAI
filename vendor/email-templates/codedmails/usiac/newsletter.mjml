        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column>
          <mj-text mj-class="footer-text">
            <p>Enjoyed this issue?</p>
          </mj-text>

          <mj-button align="left" href="https://google.com"> Share it </mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section>
  <mj-column>
