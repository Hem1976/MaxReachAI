<mjml lang="en">
  <mj-head>
    <mj-title>Welcome to Coded Mails</mj-title>
    <mj-preview>Preview - Welcome to Coded Mails</mj-preview>
    <mj-font
      name="Quattrocento"
      href="https://fonts.googleapis.com/css2?family=Quattrocento:wght@400;700&display=swap"
    />
    <mj-attributes>
      <mj-button
        text-transform="uppercase"
        font-weight="bold"
        font-size="14px"
        line-height="30px"
        background-color="#428dfc"
        color="#ffffff"
      ></mj-button>
      <mj-all font-size="14px" line-height="20px" font-family="Quattrocento"></mj-all>
      <mj-text font-weight="400" font-size="18px" color="#000" line-height="24px"></mj-text>
      <mj-class font-weight="bold" name="heading" />
      <mj-class color="#333" name="footer-text" font-size="16px" />
    </mj-attributes>
    <mj-style inline="inline">
      h1,
      h2 {
        margin: 0;
        font-size: 32px;
        line-height: 40px;
        font-weight: 700;
      }

      p {
        margin: 0;
      }

      .receipt-table td {
        font-size: 16px;
        line-height: 20px;
        word-break: normal;
      }

      a {
        color: #428dfc;
        text-decoration: none;
        font-weight: bold;
      }

      .footer-link {
        color: #000;
        font-weight: 400;
      }

      h2 {
        font-size: 24px;
        font-weight: bold;
        line-height: 24px;
      }

      h3 {
        font-size: 16px;
        font-weight: 400;
        line-height: 20px;
      }

      .date {
        margin-bottom: 5px;
        font-size: 16px;
      }
    </mj-style>
    <mj-style>
      a,
      span,
      td,
      th {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f6ab0c">
    <mj-section>
      <mj-column></mj-column>
    </mj-section>

    <mj-wrapper background-color="#ffffff" border-radius="8px 8px 0 0" padding="0px">
      <mj-section padding-bottom="0px">
        <mj-column width="100%" vertical-align="middle">
          <mj-image src="../../../images/logo.png" alt="Logo" align="center" width="150px" />
          <mj-divider border-color="#f9f9f9" />
        </mj-column>
      </mj-section>
      <mj-section background-color="#ffffff" padding-top="0px" border-radius="0 0 8px 8px">
        <mj-column width="100%">
          <mj-image
            width="200px"
            src="https://ouch-prod-var-cdn.icons8.com/vc/illustrations/previews/eTL_E1K6JcS3Wxrc.webp"
            alt="welcome image"
          />

          <mj-text>
            <h1>Email Notification</h1>
          </mj-text>

          <mj-text>
            <p>Seems like you have a new notification from coded mails.</p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-wrapper background-color="#ffffff" padding="0 20px">
      <mj-section background-color="#FFD738" border-radius="4px" padding="0px">
        <mj-column>
          <mj-text color="#6B3902" mj-class="heading" align="left">
            <p class="date">WARNING</p>

            <h2>Item Missing</h2>
          </mj-text>
          <mj-text color="#6B3902">
            <p>Your item might be out of stock. We will send it as soon as possible.</p>
          </mj-text>

          <mj-button
            background-color="#7A5A0A"
            color="#FFD738"
            align="right"
            href="https://google.com"
          >
            <strong>more details</strong>
          </mj-button>
        </mj-column>
      </mj-section>
      <mj-section padding="0">
        <mj-column>
          <mj-spacer />
        </mj-column>
      </mj-section>
      <mj-section background-color="#FF595C" border-radius="4px" padding="0px">
        <mj-column>
          <mj-text color="#fff" mj-class="heading" align="left">
            <p class="date">ALERT</p>

            <h2>Delivery Cancelled</h2>
          </mj-text>
          <mj-text color="#fff">
            <p>
              Your order could not be completed and has been cancelled. Your account has not been
              charged and we apologize for the inconvenience.
            </p>
          </mj-text>

          <mj-button
            background-color="#7A1137"
            color="#fff"
            align="right"
            href="https://google.com"
          >
            <strong>more details</strong>
          </mj-button>
        </mj-column>
      </mj-section>

      <mj-section padding="0">
        <mj-column>
          <mj-spacer />
        </mj-column>
      </mj-section>
      <mj-section background-color="#A4E246" border-radius="4px" padding="0px">
        <mj-column>
          <mj-text color="#155705" mj-class="heading" align="left">
            <p class="date">SUCCESS</p>

            <h2>Delivery Complete</h2>
          </mj-text>
          <mj-text color="#155705">
            <p>
              Your order has been delivered. If you have any question feel free to get in touch with
              us. We will be happy to assist you.
            </p>
          </mj-text>

          <mj-button
            background-color="#155705"
            color="#A4E246"
            align="right"
            href="https://google.com"
          >
            <strong>more details</strong>
          </mj-button>
        </mj-column>
      </mj-section>

      <mj-section padding="0">
        <mj-column>
          <mj-spacer />
        </mj-column>
      </mj-section>
      <mj-section background-color="#30A2FF" border-radius="4px" padding="0px">
        <mj-column>
          <mj-text color="#fff" mj-class="heading" align="left">
            <p class="date">INFO</p>

            <h2>Item Dispatched</h2>
          </mj-text>
          <mj-text color="#fff">
            <p>Your item left our warehouse. You should receive it soon.</p>
          </mj-text>

          <mj-button
            background-color="#fff"
            color="#30A2FF"
            align="right"
            href="https://google.com"
          >
            <strong>more details</strong>
          </mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-wrapper background-color="#ffffff" border-radius="0 0 8px 8px " padding="0px">
      <mj-section>
        <mj-column>
          <mj-text align="center" mj-class="footer-text">
            Have questions or need help? Email us at

            <a href="#"> hello@codedmails.com </a>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section>
  <mj-column>
    <mj-text align="center" mj-class="footer-text">
      <a class="footer-link" href="#">Support</a> &nbsp; | &nbsp;
      <a class="footer-link" href="#">Forums</a> &nbsp; | &nbsp;<a class="footer-link" href="#"
        >Contact</a
      >
      &nbsp; | &nbsp;<a class="footer-link" href="#">Log In</a>
    </mj-text>

    <mj-text mj-class="footer-text" align="center">
      123 Medalling Jr., Suite 100, Parrot Park, CA 12345<br />
      © 2020 [Coded Mails] Inc.
    </mj-text>

    <mj-social mode="horizontal" align="center">
      <mj-social-element
        alt="twitter-logo"
        icon-size="24px"
        src="../../../images/social/black/twitter-logo-transparent-black.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="facebook-logo"
        icon-size="24px"
        src="../../../images/social/black/facebook-logo-transparent-black.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="instagram-logo"
        icon-size="24px"
        src="../../../images/social/black/instagram-logo-transparent-black.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="dribbble-logo"
        icon-size="24px"
        src="../../../images/social/black/linkedin-logo-transparent-black.png"
        href="#"
      ></mj-social-element>
    </mj-social>
    <mj-text mj-class="footer-text" align="center">
      Update your
      <a class="footer-link" href="https://google.com">email preferences</a> to choose the types of
      emails you receive, or you can
      <a class="footer-link" href="https://google.com"> unsubscribe </a>from all future emails.
    </mj-text>
  </mj-column>
</mj-section>
    <mj-section>
  <mj-column>
    <mj-spacer height="1px"></mj-spacer>
  </mj-column>
</mj-section>
  </mj-body>
</mjml>
