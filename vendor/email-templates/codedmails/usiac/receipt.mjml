<mjml lang="en">
  <mj-head>
    <mj-title>Welcome to Coded Mails</mj-title>
    <mj-preview>Preview - Welcome to Coded Mails</mj-preview>
    <mj-font
      name="Quattrocento"
      href="https://fonts.googleapis.com/css2?family=Quattrocento:wght@400;700&display=swap"
    />
    <mj-attributes>
      <mj-button
        text-transform="uppercase"
        font-weight="bold"
        font-size="14px"
        line-height="30px"
        background-color="#428dfc"
        color="#ffffff"
      ></mj-button>
      <mj-all font-size="14px" line-height="20px" font-family="Quattrocento"></mj-all>
      <mj-text font-weight="400" font-size="18px" color="#000" line-height="24px"></mj-text>
      <mj-class font-weight="bold" name="heading" />
      <mj-class color="#333" name="footer-text" font-size="16px" />
    </mj-attributes>
    <mj-style inline="inline">
      h1,
      h2 {
        margin: 0;
        font-size: 32px;
        line-height: 40px;
        font-weight: 700;
      }

      p {
        margin: 0;
      }

      .receipt-table td {
        font-size: 16px;
        line-height: 20px;
        word-break: normal;
      }

      a {
        color: #428dfc;
        text-decoration: none;
        font-weight: bold;
      }

      .footer-link {
        color: #000;
        font-weight: 400;
      }
    </mj-style>
    <mj-style>
      a,
      span,
      td,
      th {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f6ab0c">
    <mj-section>
      <mj-column></mj-column>
    </mj-section>

    <mj-wrapper background-color="#ffffff" border-radius="8px">
      <mj-section background-color="#ffffff" border-radius="8px 8px 0 0" padding-bottom="0px">
        <mj-column width="100%" vertical-align="middle">
          <mj-image src="../../../images/logo.png" alt="Logo" align="center" width="150px" />
          <mj-divider border-color="#f9f9f9" />
        </mj-column>
      </mj-section>
      <mj-section background-color="#ffffff" padding-top="0px" border-radius="0 0 8px 8px">
        <mj-column width="100%">
          <mj-image
            src="https://ouch-prod-var-cdn.icons8.com/vc/illustrations/previews/eTL_E1K6JcS3Wxrc.webp"
            alt="welcome image"
          />
          <mj-text align="right" font-size="14px">
            Illustration from
            <a target="_blank" href="https://icons8.com/">Icons8</a></mj-text
          >
          <mj-text>
            <h1>Thank you for your order</h1>
          </mj-text>

          <mj-text>
            <p>Hi Monika,</p>
          </mj-text>
          <mj-text>
            <p>
              Your order has been received and is now being processed. Your order details are shown
              below for your reference:
            </p>
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="0">
  <mj-column>
    <mj-table css-class="receipt-table">
      <tr valign="top">
        <td width="60%">
          <p>Product 1</p>
          <p style="color: #aca9bb; padding-bottom: 10px">by Company ABC</p>
        </td>
        <td align="right" style="padding-top: 20px; padding-right: 5px">
          <p>x1</p>
        </td>
        <td align="right" style="padding-top: 20px">
          <p>$24.95</p>
        </td>
      </tr>
      <tr valign="top">
        <td width="60%">
          <p>Product 2 / More product info</p>
          <p style="color: #aca9bb; padding-bottom: 10px">by the Classic Company</p>
        </td>
        <td align="right" style="padding-top: 20px; padding-right: 5px">
          <p>x1</p>
        </td>
        <td align="right" style="padding-top: 20px">
          <p>$39.95</p>
        </td>
      </tr>
      <tr>
        <td
          style="
            border-bottom-width: 1px;
            border-bottom-color: #eaeeeb;
            border-bottom-style: dashed;
            padding-top: 10px;
          "
        ></td>
        <td
          style="
            border-bottom-width: 1px;
            border-bottom-color: #eaeeeb;
            border-bottom-style: dashed;
            padding-top: 10px;
          "
        ></td>
        <td
          style="
            border-bottom-width: 1px;
            border-bottom-color: #eaeeeb;
            border-bottom-style: dashed;
            padding-top: 10px;
          "
        ></td>
      </tr>
      <tr>
        <td style="padding-top: 10px"></td>
        <td align="right" style="padding-top: 10px">
          <p><small>Subtotal</small></p>
        </td>
        <td align="right" style="padding-top: 10px">
          <p><small>$64.90</small></p>
        </td>
      </tr>
      <tr>
        <td style="padding-top: 10px"></td>
        <td align="right" style="padding-top: 10px">
          <p><small>Savings</small></p>
        </td>
        <td align="right" style="padding-top: 10px">
          <p><small>-$6.48</small></p>
        </td>
      </tr>
      <tr>
        <td></td>
        <td align="right">
          <p><small>Shipping</small></p>
        </td>
        <td align="right">
          <p><small>$0.00</small></p>
        </td>
      </tr>
      <tr>
        <td></td>
        <td align="right">
          <p><small>Tax</small></p>
        </td>
        <td align="right">
          <p><small>$3.51</small></p>
        </td>
      </tr>
      <tr>
        <td style="padding-top: 20px"></td>
        <td align="right" style="padding-top: 20px"><strong>Total</strong></td>
        <td align="right" style="padding-top: 20px"><strong>$61.93</strong></td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>
      <mj-section>
        <mj-column>
          <mj-text mj-class="footer-text">
            <p>If you want to track your order, click the button below.</p>
          </mj-text>

          <mj-button align="left" href="https://google.com"> Track my order </mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section>
  <mj-column>
    <mj-text align="center" mj-class="footer-text">
      <a class="footer-link" href="#">Support</a> &nbsp; | &nbsp;
      <a class="footer-link" href="#">Forums</a> &nbsp; | &nbsp;<a class="footer-link" href="#"
        >Contact</a
      >
      &nbsp; | &nbsp;<a class="footer-link" href="#">Log In</a>
    </mj-text>

    <mj-text mj-class="footer-text" align="center">
      123 Medalling Jr., Suite 100, Parrot Park, CA 12345<br />
      © 2020 [Coded Mails] Inc.
    </mj-text>

    <mj-social mode="horizontal" align="center">
      <mj-social-element
        alt="twitter-logo"
        icon-size="24px"
        src="../../../images/social/black/twitter-logo-transparent-black.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="facebook-logo"
        icon-size="24px"
        src="../../../images/social/black/facebook-logo-transparent-black.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="instagram-logo"
        icon-size="24px"
        src="../../../images/social/black/instagram-logo-transparent-black.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="dribbble-logo"
        icon-size="24px"
        src="../../../images/social/black/linkedin-logo-transparent-black.png"
        href="#"
      ></mj-social-element>
    </mj-social>
    <mj-text mj-class="footer-text" align="center">
      Update your
      <a class="footer-link" href="https://google.com">email preferences</a> to choose the types of
      emails you receive, or you can
      <a class="footer-link" href="https://google.com"> unsubscribe </a>from all future emails.
    </mj-text>
  </mj-column>
</mj-section>
    <mj-section>
  <mj-column>
    <mj-spacer height="1px"></mj-spacer>
  </mj-column>
</mj-section>
  </mj-body>
</mjml>
