<mjml lang="en">
  <mj-head>
    <mj-title>Welcome to [Coded Mails]</mj-title>
    <mj-preview>Preview - Welcome to Coded Mails</mj-preview>
    <mj-font
      name="Roboto"
      href="https://fonts.googleapis.com/css?family=Roboto:100,300,400,700"
    ></mj-font>
    <mj-attributes>
      <mj-all font-family="Roboto, Helvetica, Arial, sans-serif"></mj-all>
      <mj-button
        line-height="20px"
        background-color="#54595f"
        color="white"
        inner-padding="8px 16px"
      ></mj-button>
      <mj-text font-weight="300" font-size="14px" line-height="20px"></mj-text>
      <mj-class name="heading" font-size="24px" line-height="30px" />
      <mj-class name="footer-text" color="#fafafa" font-size="14px" />
    </mj-attributes>
    <mj-style inline="inline">
      h1,
      h2 {
        margin: 0;
        font-size: 24px;
        line-height: normal;
        font-weight: bold;
      }

      p {
        margin: 0 0 5px 0;
      }

      .receipt-table td {
        font-size: 14px;
        line-height: 16px;
        word-break: normal;
      }

      a {
        color: #2e58ff;
        text-decoration: none;
        font-weight: 400;
      }
    </mj-style>
    <mj-style>
      a,
      span,
      td,
      th {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#54595f">
    <mj-section>
      <mj-column>
        <mj-spacer></mj-spacer>
      </mj-column>
    </mj-section>
    <mj-wrapper background-color="#fff" border-radius="4px">
      <mj-section>
        <mj-column>
          <mj-image
            align="center"
            padding="8px 0"
            width="150px"
            src="../../../images/logo.png"
          ></mj-image>

          <mj-divider border-width="1px" border-style="dashed" border-color="lightgrey" />

          <mj-text mj-class="heading"> Thank you for your order.</mj-text>

          <mj-text
            >Your order was successfully placed and your payment has been processed. Here is your
            order summary:
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="0">
  <mj-column>
    <mj-table css-class="receipt-table">
      <tr valign="top">
        <td width="60%">
          <p>Product 1</p>
          <p style="color: #aca9bb; padding-bottom: 10px">by Company ABC</p>
        </td>
        <td align="right" style="padding-top: 20px; padding-right: 5px">
          <p>x1</p>
        </td>
        <td align="right" style="padding-top: 20px">
          <p>$24.95</p>
        </td>
      </tr>
      <tr valign="top">
        <td width="60%">
          <p>Product 2 / More product info</p>
          <p style="color: #aca9bb; padding-bottom: 10px">by the Classic Company</p>
        </td>
        <td align="right" style="padding-top: 20px; padding-right: 5px">
          <p>x1</p>
        </td>
        <td align="right" style="padding-top: 20px">
          <p>$39.95</p>
        </td>
      </tr>
      <tr>
        <td
          style="
            border-bottom-width: 1px;
            border-bottom-color: #eaeeeb;
            border-bottom-style: dashed;
            padding-top: 10px;
          "
        ></td>
        <td
          style="
            border-bottom-width: 1px;
            border-bottom-color: #eaeeeb;
            border-bottom-style: dashed;
            padding-top: 10px;
          "
        ></td>
        <td
          style="
            border-bottom-width: 1px;
            border-bottom-color: #eaeeeb;
            border-bottom-style: dashed;
            padding-top: 10px;
          "
        ></td>
      </tr>
      <tr>
        <td style="padding-top: 10px"></td>
        <td align="right" style="padding-top: 10px">
          <p><small>Subtotal</small></p>
        </td>
        <td align="right" style="padding-top: 10px">
          <p><small>$64.90</small></p>
        </td>
      </tr>
      <tr>
        <td style="padding-top: 10px"></td>
        <td align="right" style="padding-top: 10px">
          <p><small>Savings</small></p>
        </td>
        <td align="right" style="padding-top: 10px">
          <p><small>-$6.48</small></p>
        </td>
      </tr>
      <tr>
        <td></td>
        <td align="right">
          <p><small>Shipping</small></p>
        </td>
        <td align="right">
          <p><small>$0.00</small></p>
        </td>
      </tr>
      <tr>
        <td></td>
        <td align="right">
          <p><small>Tax</small></p>
        </td>
        <td align="right">
          <p><small>$3.51</small></p>
        </td>
      </tr>
      <tr>
        <td style="padding-top: 20px"></td>
        <td align="right" style="padding-top: 20px"><strong>Total</strong></td>
        <td align="right" style="padding-top: 20px"><strong>$61.93</strong></td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>
      <mj-section>
        <mj-column>
          <mj-text>
            <p>
              If you have any questions or need further information about returns, you can
              <a href="#">view our return policy.</a>
            </p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section>
  <mj-column>
    <mj-text align="center" mj-class="footer-text">
      <!-- <a href="#" style="color:#fafafa">Privacy Policy</a> | <a href="#" style="color:#fafafa">Contact Support</a> | <a href="#" style="color:#fafafa">Unsubscribe</a><br /> -->
      123 Medalling Jr., Suite 100, Parrot Park, CA 12345<br />
      © 2020 [Coded Mails] Inc.</mj-text
    >

    <mj-text mj-class="footer-text" align="center">
      Update your
      <a class="footer-link" href="https://google.com">email preferences</a> to choose the types of
      emails you receive, or you can
      <a class="footer-link" href="https://google.com"> unsubscribe </a>from all future emails.
    </mj-text>
    <mj-social mode="horizontal" align="center">
      <mj-social-element
        alt="twitter-logo"
        icon-size="24px"
        src="../../../images/social/white/twitter-logo-transparent-white.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="facebook-logo"
        icon-size="24px"
        src="../../../images/social/white/facebook-logo-transparent-white.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="instagram-logo"
        icon-size="24px"
        src="../../../images/social/white/instagram-logo-transparent-white.png"
        href="#"
      ></mj-social-element>
    </mj-social>
  </mj-column>
</mj-section>
    <mj-section>
  <mj-column>
    <mj-spacer height="1px"></mj-spacer>
  </mj-column>
</mj-section>
  </mj-body>
</mjml>
