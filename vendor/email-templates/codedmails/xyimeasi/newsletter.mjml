<mjml lang="en">
  <mj-head>
    <mj-title>Welcome to [Coded Mails]</mj-title>
    <mj-preview>Preview - Welcome to Coded Mails</mj-preview>
    <mj-font
      name="Montserrat"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500&display=swap"
    ></mj-font>

    <mj-attributes>
      <mj-all
        font-family="Montserrat, Helvetica, Arial, sans-serif"
        color="#8189A9"
        font-weight="400"
      ></mj-all>
      <mj-button
        font-size="15px"
        line-height="24px"
        font-weight="500"
        background-color="#0078be"
        color="#ffffff"
      ></mj-button>
      <mj-text font-size="16px" line-height="20px"></mj-text>
      <mj-class name="heading" font-size="20px" line-height="30px" />
      <mj-class name="footer-text" font-size="14px" line-height="22px" />
      <mj-class name="sub-heading" font-size="20px" line-height="28px" />
    </mj-attributes>

    <mj-style inline="inline">
      h1,
      h2 {
        margin: 0;
        font-size: 24px;
        line-height: normal;
        font-weight: bold;
      }

      .receipt-table th {
        text-align: left;
        font-size: 20px;
        line-height: 30px;
        font-weight: 500;
      }

      .receipt-table td {
        font-size: 15px;
        line-height: 22px;
        font-weight: 400;
        word-break: normal;
      }

      a {
        color: #0078be;
        text-decoration: none;
        font-weight: 500;
      }

      h2 {
        font-size: 20px;
        line-height: 24px;
      }

      h3 {
        font-size: 16px;
        font-weight: 400;
        line-height: 20px;
      }

      .date {
        margin-bottom: 5px;
        font-size: 16px;
      }
    </mj-style>
    <mj-style>
      a,
      span,
      td,
      th {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F4F5FB">
    <mj-section>
      <mj-column>
        <mj-spacer height="5px"></mj-spacer>
      </mj-column>
    </mj-section>
    <mj-section
      border-radius="20px"
      background-repeat="no-repeat"
      background-url="https://images.unsplash.com/photo-1494894194458-0174142560c0?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=800&q=80"
    >
      <mj-column>
        <mj-image
          align="center"
          padding="8px 0"
          width="150px"
          src="../../../images/logo-white.png"
        ></mj-image>

        <mj-spacer height="250px"></mj-spacer>
      </mj-column>
    </mj-section>

    <mj-section background-color="#F4F5FB" padding="10px">
      <mj-column> </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" border-radius="20px">
      <mj-column>
        <mj-text mj-class="heading" align="center">
          <h2>Coded Mails Monthly</h2>
        </mj-text>

        <mj-text>
          <p>
            The last few months have been busy for us here at Coded mails! From upcoming virtual
            events opening up our Coded mails for Education program to all learning environments,
            this month's newsletter recaps all the latest happenings in case you happened to miss
            them.
          </p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#F4F5FB" padding="10px">
      <mj-column> </mj-column>
    </mj-section>

    <mj-wrapper background-color="#ffffff" border-radius="20px">
      <mj-section padding="0px">
        <mj-column>
          <mj-text mj-class="heading" align="center">
            <h2>Hottest topics of this month</h2>
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column width="50%">
          <mj-image
            fluid-on-mobile="true"
            src="https://images.unsplash.com/photo-1494252713559-f26b4bf0b174?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=800&h=1000&q=80"
            alt="image description"
          />
        </mj-column>
        <mj-column width="50%">
          <mj-text mj-class="heading" align="left">
            <h1>Time for some new upgrades to the system.</h1>
          </mj-text>
          <mj-text>
            <p>
              B-corp issue outcomes, blended value do-gooder social intrapreneurship catalyze.
              Outcomes inclusive social entrepreneur, save the world B-corp or venture philanthropy
              a but.
            </p>
          </mj-text>
          <mj-button href="https://google.com" align="left"> Read more </mj-button>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column width="50%">
          <mj-text mj-class="heading" align="left">
            <h1>How to make everyone happy in the company?</h1>
          </mj-text>
          <mj-text>
            <p>
              B-corp issue outcomes, blended value do-gooder social intrapreneurship catalyze.
              Outcomes inclusive social entrepreneur, save the world B-corp or venture philanthropy
              a but.
            </p>
          </mj-text>
          <mj-button href="https://google.com" align="left"> Read more </mj-button>
        </mj-column>
        <mj-column width="50%">
          <mj-image
            fluid-on-mobile="true"
            src="https://images.unsplash.com/photo-1494252713559-f26b4bf0b174?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=800&h=1000&q=80"
            alt="image description"
          />
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section background-color="#F4F5FB" padding="10px">
      <mj-column> </mj-column>
    </mj-section>

    <mj-wrapper background-color="#ffffff" border-radius="20px">
      <mj-section padding="0px">
        <mj-column>
          <mj-text mj-class="heading" align="center">
            <h2>Weekly trending topics</h2>
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column>
          <mj-text mj-class="heading" align="left">
            <p class="date">Janurary 13, 2020</p>

            <h2>Peaceful, a, social enterprise; inspiring support, shared value fairness.</h2>
          </mj-text>
          <mj-text>
            <p>
              B-corp issue outcomes, blended value do-gooder social intrapreneurship catalyze.
              Outcomes inclusive social entrepreneur, save the world B-corp or venture philanthropy
              a but.
            </p>
          </mj-text>

          <mj-button href="https://google.com" align="left"> Read more </mj-button>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column>
          <mj-image
            fluid-on-mobile="true"
            src="https://images.unsplash.com/photo-1494252713559-f26b4bf0b174?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=800&q=80"
            alt="image description"
          />

          <mj-text mj-class="heading" align="left">
            <p class="date">Janurary 12, 2020</p>

            <h2>
              <a href="https://google.com"
                >Targeted progress, innovation entrepreneur catalyze equal opportunity.</a
              >
            </h2>
          </mj-text>

          <mj-text>
            <p>
              Social return on investment unprecedented challenge, gender rights venture
              philanthropy incubator resilient co-creation youth.
            </p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section background-color="#F4F5FB" padding="10px">
      <mj-column> </mj-column>
    </mj-section>
    <mj-section background-color="#edeef6" border-radius="20px">
  <mj-column>
    <mj-social mode="horizontal" align="center">
      <mj-social-element
        alt="twitter-logo"
        icon-size="24px"
        src="../../../images/social/light/twitter-logo-transparent-light.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="facebook-logo"
        icon-size="24px"
        src="../../../images/social/light/facebook-logo-transparent-light.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="instagram-logo"
        icon-size="24px"
        src="../../../images/social/light/instagram-logo-transparent-light.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="youtube-logo"
        icon-size="24px"
        src="../../../images/social/light/youtube-logo-transparent-light.png"
        href="#"
      ></mj-social-element>
    </mj-social>

    <mj-text mj-class="footer-text" align="center">
      © 2020 [Coded Mails], Inc. 123 Louise St. #1234,<br />San Francisco, CA 12221
    </mj-text>
    <mj-text mj-class="footer-text" align="center">
      Update your
      <a class="footer-link" href="https://google.com">email preferences</a> to choose the types of
      emails you receive, or you can
      <a href="https://google.com" class="footer-link"> unsubscribe </a>from all future emails.
    </mj-text>
  </mj-column>
</mj-section>
    <mj-section>
  <mj-column>
    <mj-spacer height="1px"></mj-spacer>
  </mj-column>
</mj-section>
  </mj-body>
</mjml>
