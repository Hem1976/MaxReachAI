<mjml lang="en">
  <mj-head>
    <mj-title>Welcome to [Coded Mails]</mj-title>
    <mj-preview>Preview - Welcome to Coded Mails</mj-preview>
    <mj-font
      name="Montserrat"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500&display=swap"
    ></mj-font>

    <mj-attributes>
      <mj-all
        font-family="Montserrat, Helvetica, Arial, sans-serif"
        color="#8189A9"
        font-weight="400"
      ></mj-all>
      <mj-button
        font-size="15px"
        line-height="24px"
        font-weight="500"
        background-color="#0078be"
        color="#ffffff"
      ></mj-button>
      <mj-text font-size="16px" line-height="20px"></mj-text>
      <mj-class name="heading" font-weight="500" font-size="20px" line-height="30px" />
      <mj-class name="footer-text" font-size="14px" line-height="22px" />
      <mj-class name="sub-heading" font-size="20px" line-height="28px" />
    </mj-attributes>

    <mj-style inline="inline">
      h1,
      h2 {
        margin: 0;
        font-size: 24px;
        line-height: normal;
        font-weight: bold;
      }

      a {
        color: #0078be;
        text-decoration: none;
        font-weight: 500;
      }
    </mj-style>
    <mj-style>
      a,
      span,
      td,
      th {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#F4F5FB">
    <mj-section>
      <mj-column>
        <mj-spacer height="5px"></mj-spacer>
      </mj-column>
    </mj-section>

    <mj-section
      border-radius="20px"
      background-repeat="no-repeat"
      background-url="https://images.unsplash.com/photo-1494253109108-2e30c049369b?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=600&q=80"
    >
      <mj-column>
        <mj-image
          align="center"
          padding="8px 0"
          width="150px"
          src="../../../images/logo-white.png"
        ></mj-image>

        <mj-spacer height="250px"></mj-spacer>
      </mj-column>
    </mj-section>

    <mj-section background-color="#F4F5FB" padding="10px">
      <mj-column> </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" border-radius="20px">
      <mj-column>
        <mj-text mj-class="heading"> Reset your password?</mj-text>

        <mj-text>
          Seems like you forgot your Coded Mails password. To reset it, just click the button below.
        </mj-text>

        <mj-button align="left" href="https://google.com"> Reset Password </mj-button>

        <mj-text
          >If you have any questions simply reply to this email and we would be more than happy to
          reply. :)</mj-text
        >
      </mj-column>
    </mj-section>

    <mj-section background-color="#F4F5FB" padding="10px">
      <mj-column> </mj-column>
    </mj-section>
    <mj-section background-color="#edeef6" border-radius="20px">
  <mj-column>
    <mj-social mode="horizontal" align="center">
      <mj-social-element
        alt="twitter-logo"
        icon-size="24px"
        src="../../../images/social/light/twitter-logo-transparent-light.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="facebook-logo"
        icon-size="24px"
        src="../../../images/social/light/facebook-logo-transparent-light.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="instagram-logo"
        icon-size="24px"
        src="../../../images/social/light/instagram-logo-transparent-light.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="youtube-logo"
        icon-size="24px"
        src="../../../images/social/light/youtube-logo-transparent-light.png"
        href="#"
      ></mj-social-element>
    </mj-social>

    <mj-text mj-class="footer-text" align="center">
      © 2020 [Coded Mails], Inc. 123 Louise St. #1234,<br />San Francisco, CA 12221
    </mj-text>
    <mj-text mj-class="footer-text" align="center">
      Update your
      <a class="footer-link" href="https://google.com">email preferences</a> to choose the types of
      emails you receive, or you can
      <a href="https://google.com" class="footer-link"> unsubscribe </a>from all future emails.
    </mj-text>
  </mj-column>
</mj-section>
    <mj-section>
  <mj-column>
    <mj-spacer height="1px"></mj-spacer>
  </mj-column>
</mj-section>
  </mj-body>
</mjml>
