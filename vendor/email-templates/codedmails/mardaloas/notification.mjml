<mjml lang="en">
  <mj-head>
    <mj-title>Welcome to [Coded Mails]</mj-title>
    <mj-preview>Preview - Welcome to Coded Mails</mj-preview>
    <mj-font
      name="Inknut Antiqua"
      href="https://fonts.googleapis.com/css2?family=Inknut+Antiqua:wght@400;500;600&display=swap"
    />
    <mj-font
      name="Montserrat"
      href="https://fonts.googleapis.com/css2?family=Montserrat&display=swap"
    />
    <mj-attributes>
      <mj-button
        font-size="14px"
        line-height="30px"
        background-color="#fff"
        color="#000"
      ></mj-button>
      <mj-all
        font-size="14px"
        line-height="20px"
        font-family="Montserrat, Helvetica, Arial, sans-serif"
      ></mj-all>
      <mj-text font-weight="400" font-size="18px" color="#ddd" line-height="24px"></mj-text>
      <mj-class font-weight="bold" name="heading" />
      <mj-class color="#999" name="footer-text" font-size="16px" />
    </mj-attributes>
    <mj-style inline="inline">
      h1,
      h2 {
        margin: 0;
        font-size: 36px;
        line-height: 45px;
        font-weight: 600;
        font-family: "Inknut Antiqua", Helvetica, Arial, sans-serif;
      }

      h2 {
        font-size: 24px;
        line-height: 30px;
      }

      h3 {
        margin: 0;
        font-size: 22px;
        line-height: 26px;
        font-weight: 600;
        font-family: "Inknut Antiqua", Helvetica, Arial, sans-serif;
      }

      p {
        margin: 0;
      }

      a {
        color: #ffffff;
        text-decoration: underline;
        font-weight: bold;
      }

      .date {
        margin-bottom: 5px;
        font-size: 14px;
      }

      .footer-link {
        color: #fff;
        text-decoration: none;
        font-weight: 400;
      }
    </mj-style>
    <mj-style>
      a,
      span,
      td,
      th {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#171919">
    <mj-section padding-bottom="0px">
      <mj-column vertical-align="middle">
        <mj-image src="../../../images/logo-white.png" alt="Logo" align="center" width="150px" />
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text>
          <p>Hi Jane,</p>
        </mj-text>
        <mj-text>
          <h2>Here's what happened while you were away.</h2>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFE7D3" border-radius="4px">
      <mj-column>
        <mj-text color="#171919" mj-class="heading" align="left">
          <p class="date">ALERT</p>

          <h2>Delivery Cancelled</h2>
        </mj-text>
        <mj-text color="#171919">
          <p>
            Your order could not be completed and has been cancelled. Your account has not been
            charged and we apologize for the inconvenience.
          </p>
        </mj-text>

        <mj-button background-color="#000" color="#FFE7D3" align="right" href="https://google.com">
          <strong>more details</strong>
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section padding="0">
      <mj-column>
        <mj-spacer />
      </mj-column>
    </mj-section>
    <mj-section background-color="#D3FBD8" border-radius="4px">
      <mj-column>
        <mj-text color="#171919" mj-class="heading" align="left">
          <p class="date">SUCCESS</p>

          <h2>Delivery Complete</h2>
        </mj-text>
        <mj-text color="#171919">
          <p>Your order has been delivered.</p>
        </mj-text>

        <mj-button background-color="#000" color="#D3FBD8" align="right" href="https://google.com">
          <strong>more details</strong>
        </mj-button>
      </mj-column>
    </mj-section>
    <mj-section padding="0">
      <mj-column>
        <mj-spacer />
      </mj-column>
    </mj-section>
    <mj-section background-color="#BFFCFD" border-radius="4px">
      <mj-column>
        <mj-text color="#171919" mj-class="heading" align="left">
          <p class="date">INFO</p>

          <h2>Item Dispatched</h2>
        </mj-text>
        <mj-text color="#171919">
          <p>Your item left our warehouse. You should receive it soon.</p>
        </mj-text>

        <mj-button background-color="#000" color="#BFFCFD" align="right" href="https://google.com">
          <strong>more details</strong>
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section>
      <mj-column>
        <mj-text align="left" mj-class="footer-text">
          <p>
            Have questions or need help? Email us at
            <a href="mailto:">hello@codedmails.com</a>
          </p>
        </mj-text>
      </mj-column>
    </mj-section>
    <!-- CUSTOMIZE: FOOTER START -->
    <mj-section full-width="full-width" background-color="#000">
  <mj-column>
    <mj-text align="center" mj-class="footer-text">
      <a class="footer-link" href="#">Support</a> &nbsp; | &nbsp;
      <a class="footer-link" href="#">Privacy Policy</a>
    </mj-text>

    <mj-text mj-class="footer-text" align="center">
      123 Medalling Jr., Suite 100, Parrot Park, CA 12345
    </mj-text>

    <mj-social mode="horizontal" align="center">
      <mj-social-element
        alt="twitter-logo"
        icon-size="24px"
        src="../../../images/social/light/twitter-logo-transparent-light.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="facebook-logo"
        icon-size="24px"
        src="../../../images/social/light/facebook-logo-transparent-light.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="instagram-logo"
        icon-size="24px"
        src="../../../images/social/light/instagram-logo-transparent-light.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="dribbble-logo"
        icon-size="24px"
        src="../../../images/social/light/linkedin-logo-transparent-light.png"
        href="#"
      ></mj-social-element>
    </mj-social>
    <mj-spacer height="20px"></mj-spacer>
    <mj-text mj-class="footer-text" align="center">
      Update your
      <a class="footer-link" href="https://google.com">email preferences</a> to choose the types of
      emails you receive, or you can
      <a href="https://google.com" class="footer-link"> unsubscribe </a>from all future emails.
    </mj-text>
  </mj-column>
</mj-section>
    <!-- CUSTOMIZE: FOOTER END -->
  </mj-body>
</mjml>
