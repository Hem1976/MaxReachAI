<mjml lang="en">
  <mj-head>
    <mj-title>Welcome to Coded Mails</mj-title>
    <mj-preview>Preview - Welcome to Coded Mails</mj-preview>
    <mj-attributes>
      <mj-button
        border-radius="30px"
        text-transform="uppercase"
        font-weight="bold"
        font-size="14px"
        line-height="30px"
        background-color="#2e58ff"
        color="#ffffff"
      ></mj-button>
      <mj-all
        font-size="14px"
        line-height="20px"
        font-family="Helvetica, Arial, sans-serif"
      ></mj-all>
      <mj-text font-weight="400" font-size="18px" color="#434245" line-height="24px"></mj-text>
      <mj-class font-weight="bold" name="heading" />
      <mj-class color="#ACA9BB" name="footer-text" font-size="14px" />
      <mj-class color="#ACA9BB" name="light-text" font-size="16px" />
    </mj-attributes>
    <mj-style inline="inline">
      h1,
      h2 {
        margin: 0;
        font-size: 24px;
        line-height: normal;
        font-weight: bold;
      }

      p {
        margin: 0;
      }

      a {
        color: #2e58ff;
        text-decoration: none;
      }

      .receipt-table td {
        font-size: 16px;
        line-height: 20px;
        word-break: normal;
      }
    </mj-style>
    <mj-style>
      a,
      span,
      td,
      th {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#ffffff">
    <mj-section padding-bottom="0px">
      <mj-column>
        <mj-image
          src="../../../images/logo-circle.png"
          alt="image description"
          align="left"
          width="50px"
        />
        <mj-text>
          <h1>
            Hi John Doe, <br />
            thanks for your order
          </h1>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section>
      <mj-column>
        <mj-text>
          <p>
            Your order (#2342342) was successfully placed and your payment has been processed. Here
            is your order summary:
          </p>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0">
  <mj-column>
    <mj-table css-class="receipt-table">
      <tr valign="top">
        <td width="60%">
          <p>Product 1</p>
          <p style="color: #aca9bb; padding-bottom: 10px">by Company ABC</p>
        </td>
        <td align="right" style="padding-top: 20px; padding-right: 5px">
          <p>x1</p>
        </td>
        <td align="right" style="padding-top: 20px">
          <p>$24.95</p>
        </td>
      </tr>
      <tr valign="top">
        <td width="60%">
          <p>Product 2 / More product info</p>
          <p style="color: #aca9bb; padding-bottom: 10px">by the Classic Company</p>
        </td>
        <td align="right" style="padding-top: 20px; padding-right: 5px">
          <p>x1</p>
        </td>
        <td align="right" style="padding-top: 20px">
          <p>$39.95</p>
        </td>
      </tr>
      <tr>
        <td
          style="
            border-bottom-width: 1px;
            border-bottom-color: #eaeeeb;
            border-bottom-style: dashed;
            padding-top: 10px;
          "
        ></td>
        <td
          style="
            border-bottom-width: 1px;
            border-bottom-color: #eaeeeb;
            border-bottom-style: dashed;
            padding-top: 10px;
          "
        ></td>
        <td
          style="
            border-bottom-width: 1px;
            border-bottom-color: #eaeeeb;
            border-bottom-style: dashed;
            padding-top: 10px;
          "
        ></td>
      </tr>
      <tr>
        <td style="padding-top: 10px"></td>
        <td align="right" style="padding-top: 10px">
          <p><small>Subtotal</small></p>
        </td>
        <td align="right" style="padding-top: 10px">
          <p><small>$64.90</small></p>
        </td>
      </tr>
      <tr>
        <td style="padding-top: 10px"></td>
        <td align="right" style="padding-top: 10px">
          <p><small>Savings</small></p>
        </td>
        <td align="right" style="padding-top: 10px">
          <p><small>-$6.48</small></p>
        </td>
      </tr>
      <tr>
        <td></td>
        <td align="right">
          <p><small>Shipping</small></p>
        </td>
        <td align="right">
          <p><small>$0.00</small></p>
        </td>
      </tr>
      <tr>
        <td></td>
        <td align="right">
          <p><small>Tax</small></p>
        </td>
        <td align="right">
          <p><small>$3.51</small></p>
        </td>
      </tr>
      <tr>
        <td style="padding-top: 20px"></td>
        <td align="right" style="padding-top: 20px"><strong>Total</strong></td>
        <td align="right" style="padding-top: 20px"><strong>$61.93</strong></td>
      </tr>
    </mj-table>
  </mj-column>
</mj-section>

    <mj-section>
      <mj-column>
        <mj-text>
          <p>If you want to track your order, click the button below.</p>
        </mj-text>

        <mj-button align="left" href="https://google.com"> Track my order </mj-button>

        <mj-text mj-class="heading"> Team Coded Mails </mj-text>
        <mj-social mode="horizontal" align="left">
          <mj-social-element
            alt="twitter-logo"
            icon-size="18px"
            src="../../../images/social/black/twitter-logo-transparent-black.png"
            href="#"
          ></mj-social-element>
          <mj-social-element
            alt="facebook-logo"
            icon-size="18px"
            src="../../../images/social/black/facebook-logo-transparent-black.png"
            href="#"
          ></mj-social-element>
          <mj-social-element
            alt="instagram-logo"
            icon-size="18px"
            src="../../../images/social/black/instagram-logo-transparent-black.png"
            href="#"
          ></mj-social-element>
        </mj-social>
      </mj-column>
    </mj-section>

    <mj-section padding-top="0">
  <mj-column width="100%">
    <mj-divider border-width="1px" border-style="dashed" border-color="lightgrey" />
    <mj-text align="left" mj-class="footer-text">
      Have questions or need help? Email us at

      <a href="#"> info@codedmails.com </a>
    </mj-text>

    <mj-text mj-class="light-text">
      123 Medalling Jr., Suite 100, Parrot Park, CA 12345<br />
      © 2020 [Coded Mails] Inc.
    </mj-text>
    <mj-text mj-class="footer-text">
      Update your <a href="https://google.com">email preferences</a> to choose the types of emails
      you receive, or you can <a href="https://google.com"> unsubscribe </a>from all future emails.
    </mj-text>
  </mj-column>
</mj-section>
    <mj-section>
  <mj-column>
    <mj-spacer height="1px"></mj-spacer>
  </mj-column>
</mj-section>
  </mj-body>
</mjml>
