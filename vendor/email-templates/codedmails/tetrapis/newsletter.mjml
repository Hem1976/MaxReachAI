<mjml lang="en">
  <mj-head>
    <mj-title>Welcome to [Coded Mails]</mj-title>
    <mj-preview>Preview - Welcome to Coded Mails</mj-preview>
    <mj-font
      name="Poppins"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500&display=swap"
    ></mj-font>
    <mj-attributes>
      <mj-all font-family="Poppins, Helvetica, Arial, sans-serif"></mj-all>
      <mj-button
        font-size="18px"
        line-height="30px"
        background-color="#043768"
        color="white"
        align="left"
      ></mj-button>
      <mj-text font-weight="300" color="#003366" font-size="20px" line-height="30px"></mj-text>
      <mj-class name="footer-text" font-size="16px" font-weight="500" color="#ffffff" />
      <mj-class
        name="dark-text"
        font-size="14px"
        line-height="20px"
        font-weight="300"
        color="#043768"
      />
      <mj-class name="heading" font-weight="500" font-size="24px" line-height="30px" />
    </mj-attributes>
    <mj-style inline="inline">
      h1,
      h2 {
        margin: 0;
        font-size: 32px;
        line-height: 40px;
        font-weight: 400;
      }

      a {
        color: #00ad55;
      }

      h2 {
        font-size: 20px;
        font-weight: bold;
        line-height: 24px;
      }

      h3 {
        font-size: 16px;
        font-weight: 400;
        line-height: 20px;
      }

      .date {
        margin-bottom: 5px;
        font-size: 16px;
      }

      .receipt-table th {
        text-align: left;
        font-size: 20px;
        line-height: 30px;
        font-weight: 500;
        color: #003366;
      }

      .receipt-table td {
        color: #003366;
        font-size: 15px;
        line-height: 22px;
        font-weight: 400;
        word-break: normal;
      }

      p {
        margin: 0;
      }

      a {
        text-decoration: none;
        word-break: normal;
      }

      .footer-link {
        color: #fff;
        text-decoration: underline;
      }
    </mj-style>
    <mj-style>
      a,
      span,
      td,
      th {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f3f3f5">
    <mj-section>
      <mj-column>
        <mj-spacer></mj-spacer>
      </mj-column>
    </mj-section>
    <mj-section
      background-url="https://www.transparenttextures.com/patterns/brushed-alum.png"
      background-color="#00AD55"
      border-radius="4px 4px 0 0"
    >
      <mj-column>
        <mj-image align="center" width="150px" src="../../../images/logo-white.png"></mj-image>
        <mj-spacer></mj-spacer>

        <mj-text mj-class="heading" color="#fff" align="center">
          <p>Latest from the CodedMails blog</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section
      padding="40px 10px 20px 10px"
      background-color="#ffffff"
      border-radius="0 0 4px 4px"
    >
      <mj-column width="100%">
        <mj-text>
          <p>
            Another month is almost behind us. Which means it's time to present you with some of the
            <a href="#">great content</a> we've been busy publishing.
          </p>
        </mj-text>
        <mj-text>
          <p>So what's in the store for you this time?</p>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-wrapper background-color="#fff" padding="0px">
      <mj-section padding-top="0">
        <mj-column width="100%">
          <mj-image
            fluid-on-mobile="true"
            src="https://images.unsplash.com/photo-1557200134-90327ee9fafa?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=700&q=80"
            alt="image description"
          />
        </mj-column>
        <mj-column width="100%">
          <mj-text mj-class="heading" align="left">
            <h1>10 marketing psychology techniques to improve your emails</h1>
          </mj-text>
        </mj-column>

        <mj-column width="100%">
          <mj-text>
            <p>
              B-corp issue outcomes, blended value do-gooder social intrapreneurship catalyze.
              Outcomes inclusive social entrepreneur, save the world B-corp or venture philanthropy
              a but.
            </p>
          </mj-text>
          <mj-button href="https://google.com"> Read more </mj-button>
        </mj-column>
      </mj-section>

      <mj-section background-color="#d5d5d5">
        <mj-column width="100%">
          <mj-image
            fluid-on-mobile="true"
            src="https://images.unsplash.com/photo-1520607162513-77705c0f0d4a?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=600&q=80"
            alt="image description"
          />
        </mj-column>
        <mj-column width="100%">
          <mj-text mj-class="heading" align="left">
            <h1>
              <a href="https://google.com">Time for some new upgrades to the system attributes.</a>
            </h1>
          </mj-text>
        </mj-column>
        <mj-column width="100%">
          <mj-text>
            <p>
              B-corp issue outcomes, blended value do-gooder social intrapreneurship catalyze.
              Outcomes inclusive social entrepreneur, save the world B-corp or venture philanthropy
              a but.
            </p>
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column>
          <mj-text mj-class="heading" align="center">
            <h1>Weekly trending topics</h1>
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section background-color="#f9f9f9">
        <mj-column>
          <mj-text mj-class="heading" align="left">
            <p class="date">Janurary 13, 2020</p>

            <h2>Peaceful, a, social enterprise; inspiring support, shared value fairness.</h2>
          </mj-text>
          <mj-image
            fluid-on-mobile="true"
            src="https://images.unsplash.com/photo-1557200134-90327ee9fafa?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=700&q=80"
            alt="image description"
          />

          <mj-text>
            <p>
              B-corp issue outcomes, blended value do-gooder social intrapreneurship catalyze.
              Outcomes inclusive social entrepreneur, save the world B-corp or venture philanthropy
              a but.
            </p>
          </mj-text>

          <mj-button href="https://google.com"> Read more </mj-button>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column>
          <mj-text mj-class="heading" align="left">
            <p class="date">Janurary 12, 2020</p>

            <h2>
              <a href="https://google.com"
                >Targeted progress, innovation entrepreneur catalyze equal opportunity.</a
              >
            </h2>
          </mj-text>

          <mj-text>
            <p>
              Social return on investment unprecedented challenge, gender rights venture
              philanthropy incubator resilient co-creation youth.
            </p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section background-color="#d5d5d5">
      <mj-column width="100%">
        <mj-text>
          <h3>
            We hope you find these resources helpful, and we’ll be in touch again next week with
            more updates.
          </h3>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#043768">
  <mj-column width="100%">
    <mj-text align="left" mj-class="footer-text">
      <p>123 Medalling Jr., Suite 100, Parrot Park, CA 12345</p>
    </mj-text>
    <mj-text align="left" mj-class="footer-text">
      <p>
        Copyright © 2029 Coded Mails<br />
        All rights reserved.
      </p>
    </mj-text>
  </mj-column>
  <mj-column width="100%">
    <mj-social mode="horizontal" align="left">
      <mj-social-element
        alt="twitter-logo"
        icon-size="18px"
        src="../../../images/social/white/twitter-logo-transparent-white.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="facebook-logo"
        icon-size="18px"
        src="../../../images/social/white/facebook-logo-transparent-white.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="instagram-logo"
        icon-size="18px"
        src="../../../images/social/white/instagram-logo-transparent-white.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="youtube-logo"
        icon-size="18px"
        src="../../../images/social/white/youtube-logo-transparent-white.png"
        href="#"
      ></mj-social-element>
    </mj-social>

    <mj-text mj-class="footer-text" align="left">
      Update your
      <a class="footer-link" href="https://google.com">email preferences</a> to choose the types of
      emails you receive, or you can
      <a class="footer-link" href="https://google.com"> unsubscribe </a>from all future emails.
    </mj-text>
  </mj-column>
</mj-section>
    <mj-section>
  <mj-column>
    <mj-spacer height="1px"></mj-spacer>
  </mj-column>
</mj-section>
  </mj-body>
</mjml>
