<mjml lang="en">
  <mj-head>
    <mj-title>Welcome to [Coded Mails]</mj-title>
    <mj-preview>Preview - Welcome to Coded Mails</mj-preview>
    <mj-font
      name="Poppins"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500&display=swap"
    ></mj-font>
    <mj-attributes>
      <mj-all font-family="Poppins, Helvetica, Arial, sans-serif"></mj-all>
      <mj-button
        font-size="18px"
        line-height="30px"
        background-color="#043768"
        color="white"
        align="left"
      ></mj-button>
      <mj-text font-weight="300" color="#003366" font-size="20px" line-height="30px"></mj-text>
      <mj-class name="footer-text" font-size="16px" font-weight="500" color="#ffffff" />
      <mj-class
        name="dark-text"
        font-size="14px"
        line-height="20px"
        font-weight="300"
        color="#043768"
      />
      <mj-class name="heading" font-weight="500" font-size="24px" line-height="30px" />
    </mj-attributes>
    <mj-style inline="inline">
      h1,
      h2 {
        margin: 0;
        font-size: 32px;
        line-height: 40px;
        font-weight: 400;
      }

      a {
        color: #00ad55;
      }

      h2 {
        font-size: 20px;
        font-weight: bold;
        line-height: 24px;
      }

      h3 {
        font-size: 16px;
        font-weight: 400;
        line-height: 20px;
      }

      .date {
        margin-bottom: 5px;
        font-size: 16px;
      }

      .receipt-table th {
        text-align: left;
        font-size: 20px;
        line-height: 30px;
        font-weight: 500;
        color: #003366;
      }

      .receipt-table td {
        color: #003366;
        font-size: 15px;
        line-height: 22px;
        font-weight: 400;
        word-break: normal;
      }

      p {
        margin: 0;
      }

      a {
        text-decoration: none;
        word-break: normal;
      }

      .footer-link {
        color: #fff;
        text-decoration: underline;
      }
    </mj-style>
    <mj-style>
      a,
      span,
      td,
      th {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f3f3f5">
    <mj-section>
      <mj-column>
        <mj-spacer></mj-spacer>
      </mj-column>
    </mj-section>
    <mj-section
      background-url="https://www.transparenttextures.com/patterns/brushed-alum.png"
      background-color="#00AD55"
      border-radius="4px 4px 0 0"
    >
      <mj-column>
        <mj-image align="center" width="150px" src="../../../images/logo-white.png"></mj-image>
        <mj-spacer></mj-spacer>

        <mj-text mj-class="heading" color="#fff" align="center">
          <p>You have a new notification</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section
      padding="40px 10px 20px 10px"
      background-color="#ffffff"
      border-radius="0 0 4px 4px"
    >
      <mj-column width="100%">
        <mj-text>
          <p>So here are some of the notification you have received?</p>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-wrapper background-color="#fff" border-radius="4px" padding="20px">
      <mj-section
        background-url="https://www.transparenttextures.com/patterns/brushed-alum.png"
        background-color="#8E1341"
        border-radius="4px"
      >
        <mj-column>
          <mj-text color="#fff" mj-class="heading" align="left">
            <p class="date">ALERT</p>

            <h2>Delivery Cancelled</h2>
          </mj-text>
          <mj-text color="#fff">
            <p>
              Your order could not be completed and has been cancelled. Your account has not been
              charged and we apologize for the inconvenience.
            </p>
          </mj-text>

          <mj-button background-color="#fff" color="#9E2E1F" align="left" href="https://google.com">
            <strong>Details</strong>
          </mj-button>
        </mj-column>
      </mj-section>

      <mj-section padding="0">
        <mj-column>
          <mj-spacer />
        </mj-column>
      </mj-section>
      <mj-section
        background-url="https://www.transparenttextures.com/patterns/brushed-alum.png"
        background-color="#1D872B"
        border-radius="4px"
      >
        <mj-column>
          <mj-text color="#fff" mj-class="heading" align="left">
            <p class="date">SUCCESS</p>

            <h2>Delivery Complete</h2>
          </mj-text>
          <mj-text color="#fff">
            <p>
              Your order has been delivered. If you have any question feel free to get in touch with
              us. We will be happy to assist you.
            </p>
          </mj-text>

          <mj-button background-color="#fff" color="#1D872B" align="left" href="https://google.com">
            <strong>Details</strong>
          </mj-button>
        </mj-column>
      </mj-section>
      <mj-section padding="0">
        <mj-column>
          <mj-spacer />
        </mj-column>
      </mj-section>
      <mj-section
        background-url="https://www.transparenttextures.com/patterns/brushed-alum.png"
        background-color="#006E89"
        border-radius="4px"
      >
        <mj-column>
          <mj-text color="#fff" mj-class="heading" align="left">
            <p class="date">INFO</p>

            <h2>Item Dispatched</h2>
          </mj-text>
          <mj-text color="#fff">
            <p>Your item left our warehouse. You should receive it soon.</p>
          </mj-text>

          <mj-button background-color="#fff" color="#006E89" align="left" href="https://google.com">
            <strong>Details</strong>
          </mj-button>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column>
          <mj-text>
            <p>
              If you have any questions simply reply to this email and we would be more than happy
              to reply. :)
            </p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section background-color="#d5d5d5">
      <mj-column width="100%">
        <mj-text>
          <h3>
            We hope you find these resources helpful, and we’ll be in touch again next week with
            more updates.
          </h3>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#043768">
  <mj-column width="100%">
    <mj-text align="left" mj-class="footer-text">
      <p>123 Medalling Jr., Suite 100, Parrot Park, CA 12345</p>
    </mj-text>
    <mj-text align="left" mj-class="footer-text">
      <p>
        Copyright © 2029 Coded Mails<br />
        All rights reserved.
      </p>
    </mj-text>
  </mj-column>
  <mj-column width="100%">
    <mj-social mode="horizontal" align="left">
      <mj-social-element
        alt="twitter-logo"
        icon-size="18px"
        src="../../../images/social/white/twitter-logo-transparent-white.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="facebook-logo"
        icon-size="18px"
        src="../../../images/social/white/facebook-logo-transparent-white.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="instagram-logo"
        icon-size="18px"
        src="../../../images/social/white/instagram-logo-transparent-white.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="youtube-logo"
        icon-size="18px"
        src="../../../images/social/white/youtube-logo-transparent-white.png"
        href="#"
      ></mj-social-element>
    </mj-social>

    <mj-text mj-class="footer-text" align="left">
      Update your
      <a class="footer-link" href="https://google.com">email preferences</a> to choose the types of
      emails you receive, or you can
      <a class="footer-link" href="https://google.com"> unsubscribe </a>from all future emails.
    </mj-text>
  </mj-column>
</mj-section>
    <mj-section>
  <mj-column>
    <mj-spacer height="1px"></mj-spacer>
  </mj-column>
</mj-section>
  </mj-body>
</mjml>
