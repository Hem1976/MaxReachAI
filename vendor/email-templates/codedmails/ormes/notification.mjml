<mjml lang="en">
  <mj-head>
    <mj-title>Welcome to Coded Mails</mj-title>
    <mj-preview>Preview - Welcome to Coded Mails</mj-preview>
    <mj-font name="Lato" href="https://fonts.googleapis.com/css?family=Lato:300,400,700"></mj-font>
    <mj-attributes>
      <mj-button
        text-transform="uppercase"
        font-weight="bold"
        font-size="14px"
        line-height="40px"
        background-color="#2e58ff"
        color="white"
      ></mj-button>
      <mj-all font-family="Lato,'Helvetica Neue',Helvetica,Arial,sans-serif"></mj-all>
      <mj-text font-weight="400" font-size="18px" color="#434245" line-height="24px"></mj-text>
      <mj-class
        name="footer-text"
        color="#bfbfbf"
        font-size="15px"
        align="center"
        line-height="20px"
      ></mj-class>
    </mj-attributes>
    <mj-style inline="inline">
      h1,
      h2 {
        margin: 0;
        font-size: 24px;
        line-height: normal;
        font-weight: bold;
      }

      h2 {
        font-size: 24px;
        line-height: 30px;
      }

      h3 {
        margin: 0;
        font-size: 18px;
        line-height: 22px;
      }

      p {
        margin: 0;
      }

      a {
        color: #2e58ff;
        text-decoration: none;
      }

      .date {
        margin-bottom: 5px;
        font-size: 14px;
      }

      .footer-link {
        color: #999;
        text-decoration: underline;
      }
    </mj-style>
    <mj-style>
      a,
      span,
      td,
      th {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#ffffff">
    <mj-section padding-bottom="0px">
      <mj-column width="100%">
        <mj-image src="../../../images/logo.png" alt="Logo" align="left" width="150px" />
        <mj-spacer></mj-spacer>

        <mj-image
          src="https://images.unsplash.com/photo-1543857778-c4a1a3e0b2eb?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=800&h=200&q=80"
          width="800px"
          alt="image description"
          padding="0"
          href="https://google.com"
        />
      </mj-column>
    </mj-section>
    <mj-section padding-bottom="0px">
      <mj-column>
        <mj-text font-weight="700" align="center" line-height="32px" font-size="24px">
          <h1>Hi John, you have some unread notifications.</h1>
        </mj-text>

        <mj-text>
          <p>
            One morning, when Gregor Samsa woke from troubled dreams, he found himself transformed
            in his bed into a horrible vermin.
          </p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper>
      <mj-section background-color="#FF3653" border-radius="4px">
        <mj-column>
          <mj-text color="#fff" mj-class="heading" align="left">
            <p class="date">ALERT</p>

            <h2>Delivery Cancelled</h2>
          </mj-text>
          <mj-text color="#fff">
            <p>
              Your order could not be completed and has been cancelled. Your account has not been
              charged and we apologize for the inconvenience.
            </p>
          </mj-text>

          <mj-button
            background-color="#fff"
            color="#FF3653"
            align="right"
            href="https://google.com"
          >
            <strong>more details</strong>
          </mj-button>
        </mj-column>
      </mj-section>

      <mj-section padding="0">
        <mj-column>
          <mj-spacer />
        </mj-column>
      </mj-section>
      <mj-section background-color="#008852" border-radius="4px">
        <mj-column>
          <mj-text color="#fff" mj-class="heading" align="left">
            <p class="date">SUCCESS</p>

            <h2>Delivery Complete</h2>
          </mj-text>
          <mj-text color="#fff">
            <p>Your order has been delivered.</p>
          </mj-text>

          <mj-button
            background-color="#fff"
            color="#008852"
            align="right"
            href="https://google.com"
          >
            <strong>more details</strong>
          </mj-button>
        </mj-column>
      </mj-section>
      <mj-section padding="0">
        <mj-column>
          <mj-spacer />
        </mj-column>
      </mj-section>
      <mj-section background-color="#2E58FF" border-radius="4px">
        <mj-column>
          <mj-text color="#fff" mj-class="heading" align="left">
            <p class="date">INFO</p>

            <h2>Item Dispatched</h2>
          </mj-text>
          <mj-text color="#fff">
            <p>Your item left our warehouse. You should receive it soon.</p>
          </mj-text>

          <mj-button
            background-color="#fff"
            color="#2e58ff"
            align="right"
            href="https://google.com"
          >
            <strong>more details</strong>
          </mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section>
      <mj-column>
        <mj-text>
          <p>Tempora culpa porro labore: In quisquam optio quibusdam fugiat perspiciatis nobis</p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-wrapper full-width="full-width" background-color="#fafafa">
  <mj-section>
    <mj-column>
      <mj-social mode="horizontal" align="center">
  <mj-social-element
    alt="twitter-logo"
    icon-size="32px"
    src="../../../images/social/color/twitter-logo-transparent.png"
    href="#"
  ></mj-social-element>
  <mj-social-element
    alt="facebook-logo"
    icon-size="32px"
    src="../../../images/social/color/facebook-logo-transparent.png"
    href="#"
  ></mj-social-element>
  <mj-social-element
    alt="instagram-logo"
    icon-size="32px"
    src="../../../images/social/color/insta-logo-transparent.png"
    href="#"
  ></mj-social-element>
  <mj-social-element
    alt="youtube-logo"
    icon-size="32px"
    src="../../../images/social/color/youtube-logo-transparent.png"
    href="#"
  ></mj-social-element>
</mj-social>
      <mj-text mj-class="footer-text">
        Update your
        <a class="footer-link" href="https://google.com">email preferences</a>
        to choose the types of emails you receive, or you can
        <a href="https://google.com" class="footer-link"> unsubscribe </a>from all future emails.
      </mj-text>
      <mj-text color="#bfbfbf" font-size="15px" align="center" line-height="20px">
        &copy; Coded Mails Inc., All Rights Reserved.
      </mj-text>

      <mj-spacer />
    </mj-column>
  </mj-section>
</mj-wrapper>
  </mj-body>
</mjml>
