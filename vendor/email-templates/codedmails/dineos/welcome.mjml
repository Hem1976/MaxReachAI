<mjml lang="en">
  <mj-head>
    <mj-title>Welcome to [Coded Mails]</mj-title>
    <mj-preview>Preview - Welcome to Coded Mails</mj-preview>
    <mj-font name="Muli" href="https://fonts.googleapis.com/css?family=Muli:300,400,700"></mj-font>

    <mj-attributes>
      <mj-all font-family="Muli, Arial, sans-serif" color="#333"></mj-all>
      <mj-button
        line-height="30px"
        background-color="#e6b07e"
        color="white"
        inner-padding="8px 16px"
      ></mj-button>
      <mj-text font-weight="400" font-size="14px" line-height="20px"></mj-text>
      <mj-class name="heading" font-size="20px" line-height="30px" />
      <mj-class name="footer-text" font-size="14px" line-height="20px" />
      <mj-class name="sub-heading" font-weight="400" font-size="20px" line-height="28px" />
    </mj-attributes>

    <mj-style inline="inline">
      h1,
      h2 {
        margin: 0;
        font-size: 24px;
        line-height: normal;
        font-weight: bold;
      }

      a {
        color: #2e58ff;
        text-decoration: none;
      }
    </mj-style>
    <mj-style>
      a,
      span,
      td,
      th {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f9f0e6">
    <mj-section>
      <mj-column>
        <mj-spacer></mj-spacer>

        <mj-image align="center" width="75px" src="../../../images/logo-circle-gray.png"></mj-image>
      </mj-column>
    </mj-section>
    <mj-hero
      height="300px"
      background-url="https://images.unsplash.com/photo-1536560035542-1326fab3a507?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=800&q=80"
      background-color="#2a3448"
    ></mj-hero>

    <mj-wrapper padding="0px" background-color="#fff">
      <mj-section padding-bottom="0px">
        <mj-column>
          <mj-text mj-class="heading">
            <h1>Hi John, Welcome to [Coded Mails]</h1>
          </mj-text>

          <mj-divider border-width="1px" border-color="#F4F5FB" />
          <mj-text>Here are the next steps to get you started:</mj-text>

          <mj-text>
            <h2>1. Verify Your Account</h2>
          </mj-text>
          <mj-text>
            To ensure you're legitimate and not a fake person, please verify your account by
            clicking the button below.
          </mj-text>
          <mj-button align="left" href="[LINK]" border="2px solid #e6b07e">
            Verify my account
          </mj-button>
        </mj-column>
      </mj-section>

      <mj-section padding="0px">
        <mj-column>
          <mj-text>
            <h2>2. Complete your profile</h2>
          </mj-text>
          <mj-text>
            To ensure you're legitimate and not a fake person, please verify your account by
            clicking the button below.
          </mj-text>
          <mj-button
            background-color="#fff"
            color="#8189A9"
            align="left"
            href="[LINK]"
            border="2px solid #8189A9"
          >
            Complete my profile
          </mj-button>
        </mj-column>
      </mj-section>

      <mj-section padding="0px">
        <mj-column>
          <mj-text>
            <h2>3. Download our app</h2>
          </mj-text>

          <mj-text>
            <a href="#" style="display: inline-block; text-decoration: none">
              <img src="../../images/google-play.png" alt="play-store-logo" width="150px" />
            </a>
            <a href="#" style="display: inline-block; text-decoration: none">
              <img src="../../images/app-store.png" alt="app-store-logo" width="150px" />
            </a>
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding-top="0px">
        <mj-column>
          <mj-text>
            <h2>4. Follow us</h2>
          </mj-text>
          <mj-social mode="horizontal" align="left">
            <mj-social-element
              alt="twitter-logo"
              icon-size="32px"
              src="../../../images/social/color/twitter-logo-transparent.png"
              href="#"
            ></mj-social-element>
            <mj-social-element
              alt="facebook-logo"
              icon-size="32px"
              src="../../../images/social/color/facebook-logo-transparent.png"
              href="#"
            ></mj-social-element>
            <mj-social-element
              alt="instagram-logo"
              icon-size="32px"
              src="../../../images/social/color/insta-logo-transparent.png"
              href="#"
            ></mj-social-element>
            <mj-social-element
              alt="youtube-logo"
              icon-size="32px"
              src="../../../images/social/color/youtube-logo-transparent.png"
              href="#"
            ></mj-social-element>
          </mj-social>

          <mj-text>Thank you and welcome onboard :) </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section>
  <mj-column>
    <mj-text mj-class="footer-text" align="center">
      © 2020 [Coded Mails], Inc. 123 Louise St. #1234, San Francisco, CA 12221
    </mj-text>
    <mj-text mj-class="footer-text" align="center">
      Update your <a href="https://google.com">email preferences</a> to choose the types of emails
      you receive, or you can <a href="https://google.com"> unsubscribe </a>from all future emails.
    </mj-text>
  </mj-column>
</mj-section>
    <mj-section>
  <mj-column>
    <mj-spacer height="1px"></mj-spacer>
  </mj-column>
</mj-section>
  </mj-body>
</mjml>
