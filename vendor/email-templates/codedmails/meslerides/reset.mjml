<mjml lang="en">
  <mj-head>
    <mj-title>Welcome to [Coded Mails]</mj-title>
    <mj-preview>Preview - Welcome to Coded Mails</mj-preview>
    <mj-attributes>
      <mj-button
        padding="10px 20px"
        font-size="16px"
        line-height="30px"
        background-color="#fc4f95"
        color="#ffffff"
      ></mj-button>
      <mj-all
        font-size="14px"
        line-height="20px"
        font-family="Helvetica, Arial, sans-serif"
      ></mj-all>
      <mj-text
        padding="10px 20px"
        font-weight="400"
        font-size="20px"
        color="#fff"
        line-height="26px"
      ></mj-text>
      <mj-class font-weight="bold" name="heading" />
      <mj-section padding="0px" />
      <mj-column padding="0px" />
      <mj-image padding="0px" />
      <mj-class color="#000" name="footer-text" font-size="14px" />
    </mj-attributes>
    <mj-style inline="inline">
      h1,
      h2 {
        margin: 0;
        font-size: 46px;
        line-height: 46px;
        font-weight: bold;
      }

      p {
        margin: 0;
      }

      a {
        color: #fc4f95;
        text-decoration: none;
        font-weight: bold;
      }

      .footer-link {
        color: #171919;
        font-weight: 400;
      }
    </mj-style>
    <mj-style>
      a,
      span,
      td,
      th {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#ffffff">
    <mj-section padding-top="20px">
      <mj-column vertical-align="middle">
        <mj-image
          padding="20px"
          container-background-color="#36ccf2"
          src="../../../images/logo-white.png"
          alt="Logo"
          align="center"
          width="150px"
        />
      </mj-column>
    </mj-section>
    <mj-section>
      <mj-column>
        <mj-image
          src="https://images.unsplash.com/photo-1528101759-6c82d7e735e5?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=800&h=600&q=80"
          alt="welcome image"
        />
      </mj-column>
    </mj-section>

    <mj-section background-color="#36ccf2" padding-bottom="10px">
      <mj-column>
        <mj-text>
          <h1>Reset your password?</h1>
        </mj-text>

        <mj-text>
          <p>
            No problem! Just click the button below and you’ll be on your way. If you did not make
            this request, please ignore this email.
          </p>
        </mj-text>

        <mj-button css-class="hover" align="center" href="https://google.com">
          Reset your password
        </mj-button>

        <mj-text align="left" mj-class="footer-text">
          Have questions or need help? Email us at

          <a href="#"> hello@codedmails.com </a>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#FFC441" padding-bottom="10px">
  <mj-column width="100%">
    <mj-text align="left" mj-class="footer-text">
      123 Medalling Jr., Suite 100, Parrot Park, CA 12345<br />
      © 2020 [Coded Mails] Inc.</mj-text
    >

    <mj-text mj-class="footer-text" align="left">
      Update your
      <a class="footer-link" href="https://google.com">email preferences</a> to choose the types of
      emails you receive, or you can
      <a href="https://google.com" class="footer-link"> unsubscribe </a>from all future emails.
    </mj-text>
  </mj-column>

  <mj-column width="100%">
    <mj-social mode="horizontal" align="left">
      <mj-social-element
        alt="twitter-logo"
        icon-size="18px"
        src="../../../images/social/black/twitter-logo-transparent-black.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="facebook-logo"
        icon-size="18px"
        src="../../../images/social/black/facebook-logo-transparent-black.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="instagram-logo"
        icon-size="18px"
        src="../../../images/social/black/instagram-logo-transparent-black.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="youtube-logo"
        icon-size="18px"
        src="../../../images/social/black/youtube-logo-transparent-black.png"
        href="#"
      ></mj-social-element>
    </mj-social>
  </mj-column>
</mj-section>

    <mj-section>
      <mj-column>
        <mj-spacer height="20px"></mj-spacer>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
