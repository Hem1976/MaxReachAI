<mjml lang="en">
  <mj-head>
    <mj-title>Welcome to [Coded Mails]</mj-title>
    <mj-preview>Preview - Welcome to Coded Mails</mj-preview>
    <mj-attributes>
      <mj-button
        padding="10px 20px 20px"
        font-size="16px"
        line-height="30px"
        background-color="#fc4f95"
        color="#ffffff"
      ></mj-button>
      <mj-all
        font-size="14px"
        line-height="20px"
        font-family="Helvetica, Arial, sans-serif"
      ></mj-all>
      <mj-text
        padding="10px 20px"
        font-weight="400"
        font-size="20px"
        color="#fff"
        line-height="26px"
      ></mj-text>
      <mj-class font-weight="bold" name="heading" />
      <mj-section padding="0px" />
      <mj-column padding="0px" />
      <mj-image padding="0px" />
      <mj-class color="#000" name="footer-text" font-size="14px" />
      <mj-class color="#000" name="text-small" font-size="14px" />
    </mj-attributes>
    <mj-style inline="inline">
      h1,
      h2 {
        margin: 0;
        font-size: 46px;
        line-height: 46px;
        font-weight: bold;
      }

      h2 {
        font-size: 24px;
        line-height: 30px;
      }

      h3 {
        margin: 0;
        font-size: 22px;
        line-height: 26px;
        font-weight: 600;
        font-family: "Inknut Antiqua", Helvetica, Arial, sans-serif;
      }

      p {
        margin: 0;
      }

      .receipt-table td {
        color: #000;
        font-size: 15px;
        line-height: 24px;
        word-break: normal;
      }

      .light-text p,
      .light-text small {
        color: #000;
      }

      a {
        color: #fc4f95;
        text-decoration: none;
        font-weight: bold;
      }

      .footer-link {
        color: #171919;
        font-weight: 400;
        text-decoration: underline;
      }

      .date {
        margin-bottom: 5px;
        font-size: 14px;
      }
    </mj-style>
    <mj-style>
      a,
      span,
      td,
      th {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#ffffff">
    <mj-section padding-top="20px">
      <mj-column vertical-align="middle">
        <mj-image
          padding="20px"
          container-background-color="#36ccf2"
          src="../../../images/logo-white.png"
          alt="Logo"
          align="center"
          width="150px"
        />
      </mj-column>
    </mj-section>

    <mj-wrapper background-color="#36ccf2" padding="0">
      <mj-section>
        <mj-column>
          <mj-image
            src="https://images.unsplash.com/photo-1453814235491-3cfac3999928?ixlib=rb-1.2.1&auto=format&fit=crop&w=800&q=80"
          >
          </mj-image>
          <mj-text mj-class="heading" align="left">
            <p class="date">Janurary 13, 2020</p>

            <h2>Peaceful, a, social enterprise; inspiring support, shared value fairness.</h2>
          </mj-text>
          <mj-text>
            <p>
              B-corp issue outcomes, blended value do-gooder social intrapreneurship catalyze.
              Outcomes inclusive social entrepreneur, save the world B-corp or venture philanthropy
              a but.
            </p>
          </mj-text>

          <mj-button align="left" href="https://google.com">
            <strong>Read more</strong>
          </mj-button>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column width="50%">
          <mj-image
            fluid-on-mobile="true"
            src="https://images.unsplash.com/photo-1501703380849-59652657bb90?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=600&q=80"
            alt="image description"
          />
          <mj-text mj-class="heading" align="left">
            <p class="date">Janurary 12, 2020</p>

            <h2>Targeted progress, innovation entrepreneur catalyze equal opportunity.</h2>
          </mj-text>

          <mj-text>
            <p>
              Social return on investment unprecedented challenge, gender rights venture
              philanthropy incubator resilient co-creation youth.
            </p>
          </mj-text>

          <mj-button align="left" href="https://google.com">
            <strong>Read more</strong>
          </mj-button>
        </mj-column>
        <mj-column width="50%">
          <mj-image
            fluid-on-mobile="true"
            src="https://images.unsplash.com/photo-1489350449139-07b4d33113f4?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=600&q=80"
            alt="image description"
          />
          <mj-text mj-class="heading" align="left">
            <p class="date">Janurary 12, 2020</p>

            <h2>Targeted progress, innovation entrepreneur catalyze equal opportunity.</h2>
          </mj-text>

          <mj-text>
            <p>
              Social return on investment unprecedented challenge, gender rights venture
              philanthropy incubator resilient co-creation youth.
            </p>
          </mj-text>
          <mj-button align="left" href="https://google.com">
            <strong>Read more</strong>
          </mj-button>
        </mj-column>
      </mj-section>
      <mj-section background-color="#999">
        <mj-column>
          <mj-text mj-class="heading" align="left">
            <p class="date">Janurary 13, 2020</p>

            <h2>Social enterprise; inspiring support, shared value fairness.</h2>
          </mj-text>
          <mj-text>
            <p>
              B-corp issue outcomes, blended value do-gooder social intrapreneurship catalyze.
              Outcomes inclusive social entrepreneur, save the world B-corp or venture philanthropy
              a but.
            </p>
          </mj-text>

          <mj-button align="left" href="https://google.com">
            <strong>Read more</strong>
          </mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section background-color="#36ccf2" padding-bottom="0">
      <mj-column>
        <mj-text align="left" mj-class="footer-text">
          Have questions or need help? Email us at

          <a href="#"> hello@codedmails.com </a>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#FFC441" padding-bottom="10px">
  <mj-column width="100%">
    <mj-text align="left" mj-class="footer-text">
      123 Medalling Jr., Suite 100, Parrot Park, CA 12345<br />
      © 2020 [Coded Mails] Inc.</mj-text
    >

    <mj-text mj-class="footer-text" align="left">
      Update your
      <a class="footer-link" href="https://google.com">email preferences</a> to choose the types of
      emails you receive, or you can
      <a href="https://google.com" class="footer-link"> unsubscribe </a>from all future emails.
    </mj-text>
  </mj-column>

  <mj-column width="100%">
    <mj-social mode="horizontal" align="left">
      <mj-social-element
        alt="twitter-logo"
        icon-size="18px"
        src="../../../images/social/black/twitter-logo-transparent-black.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="facebook-logo"
        icon-size="18px"
        src="../../../images/social/black/facebook-logo-transparent-black.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="instagram-logo"
        icon-size="18px"
        src="../../../images/social/black/instagram-logo-transparent-black.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="youtube-logo"
        icon-size="18px"
        src="../../../images/social/black/youtube-logo-transparent-black.png"
        href="#"
      ></mj-social-element>
    </mj-social>
  </mj-column>
</mj-section>

    <mj-section>
      <mj-column>
        <mj-spacer height="20px"></mj-spacer>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
