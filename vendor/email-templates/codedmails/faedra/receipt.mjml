<mjml lang="en">
  <mj-head>
    <mj-title>Welcome to [Coded Mails]</mj-title>
    <mj-preview>Preview - Welcome to Coded Mails</mj-preview>
    <mj-font
      name="Nunito"
      href="https://fonts.googleapis.com/css?family=Nunito:100,400,700"
    ></mj-font>
    <mj-attributes>
      <mj-all
        font-family="Nunito, Helvetica, Arial, sans-serif"
        font-size="16px"
        color="#54595f"
      ></mj-all>
      <mj-button
        border-radius="30px"
        line-height="30px"
        background-color="#54595f"
        color="white"
        align="center"
      ></mj-button>
      <mj-text font-weight="400" line-height="20px"></mj-text>
      <mj-class name="footer-text" color="#54595f" font-size="14px" line-height="18px" />
      <mj-class
        name="light-text"
        color="#999"
        padding="5px 0 0 0"
        font-size="14px"
        line-height="18px"
      />
    </mj-attributes>
    <mj-style inline="inline">
      h1,
      h2 {
        margin: 0;
        font-size: 24px;
        line-height: 32px;
        line-height: normal;
        font-weight: bold;
      }

      .receipt-table td {
        font-size: 16px;
        line-height: 20px;
        word-break: normal;
      }

      p {
        margin: 0 0 5px 0;
      }

      a {
        color: #54595f;
        text-decoration: underline;
      }
    </mj-style>
    <mj-style>
      a,
      span,
      td,
      th {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#eaeaea">
    <mj-section>
      <mj-column>
        <mj-spacer></mj-spacer>
      </mj-column>
    </mj-section>

    <mj-section
      border-radius="20px 20px 0 0"
      background-size="cover"
      background-repeat="no-repeat"
      background-url="https://images.unsplash.com/photo-1535551951406-a19828b0a76b?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=800&q=80"
    >
      <mj-column>
        <mj-image
          align="center"
          padding="8px 0"
          width="150px"
          src="../../../images/logo-white.png"
        ></mj-image>

        <mj-spacer height="100px"></mj-spacer>
      </mj-column>
    </mj-section>
    <mj-section background-color="#ffffff">
      <mj-column>
        <mj-text align="left">
          <h1>Thank you for your order, John Doe</h1>
        </mj-text>

        <mj-text align="left">
          <p>
            Your order was successfully placed and your payment has been processed. Here is your
            order summary:
          </p>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-wrapper background-color="#f9f9f9" padding="10px 25px">
  <mj-section padding="5px 0" padding="5px 0">
    <mj-group>
      <mj-column>
        <mj-text font-size="14px" line-height="20px" padding="5px 0 0 0">
          <p>December 18, 2020</p>
        </mj-text>
      </mj-column>
      <mj-column>
        <mj-text align="right" mj-class="light-text" font-weight="700">
          <p>Order No: 788233</p>
        </mj-text>
      </mj-column>
    </mj-group>
  </mj-section>
  <mj-section border-bottom="1px solid #ddd" border-top="1px solid #ddd" padding="5px 0">
    <mj-group>
      <mj-column>
        <mj-text
          letter-spacing="1px"
          font-size="14px"
          font-weight="bold"
          padding="5px 0 0 0"
          text-transform="uppercase"
        >
          <p>Items Ordered</p>
        </mj-text>
      </mj-column>
    </mj-group>
  </mj-section>

  <mj-section border-bottom="1px solid #ddd" padding="10px 0 5px 0">
    <mj-column width="25%">
      <mj-image
        padding="0 5px 5px 0"
        fluid-on-mobile="true"
        src="https://images.unsplash.com/photo-1591195853828-11db59a44f6b?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=600&q=80"
      />
    </mj-column>
    <mj-column width="50%">
      <mj-text padding="0">
        <p>Product Name</p>
      </mj-text>
      <mj-text mj-class="light-text" padding="0">
        <p><strong>Size:</strong> 32X30 Athletic</p>
      </mj-text>
      <mj-text mj-class="light-text" padding="0">
        <p><strong>Color:</strong> Slate Grey</p>
      </mj-text>
      <mj-text mj-class="light-text" padding="0">
        <p><strong>Qty:</strong> 2</p>
      </mj-text>
    </mj-column>
    <mj-column width="25%" vertical-align="bottom">
      <mj-text align="right" padding="0">
        <p>$28.00</p>
      </mj-text>
    </mj-column>
  </mj-section>

  <mj-section border-bottom="1px solid #ddd" padding="10px 0 5px 0">
    <mj-column width="25%">
      <mj-image
        padding="0 5px 5px 0"
        fluid-on-mobile="true"
        src="https://images.unsplash.com/photo-1529634885322-b17ffaf423ac?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=600&q=80"
      />
    </mj-column>
    <mj-column width="50%">
      <mj-text padding="0">
        <p>Product Name</p>
      </mj-text>
      <mj-text mj-class="light-text" padding="0">
        <p><strong>Size:</strong> 32X30 Athletic</p>
      </mj-text>
      <mj-text mj-class="light-text" padding="0">
        <p><strong>Color:</strong> Slate Grey</p>
      </mj-text>
      <mj-text mj-class="light-text" padding="0">
        <p><strong>Qty:</strong> 2</p>
      </mj-text>
    </mj-column>
    <mj-column width="25%" vertical-align="bottom">
      <mj-text align="right" padding="0">
        <p>$32.00</p>
      </mj-text>
    </mj-column>
  </mj-section>
  <mj-section border-bottom="1px solid #ddd" padding="10px 0 5px 0">
    <mj-column width="25%">
      <mj-image
        padding="0 5px 5px 0"
        fluid-on-mobile="true"
        src="https://images.unsplash.com/photo-1572635196237-14b3f281503f?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=600&q=80"
      />
    </mj-column>
    <mj-column width="50%">
      <mj-text padding="0">
        <p>Product Name</p>
      </mj-text>
      <mj-text mj-class="light-text" padding="0">
        <p><strong>Size:</strong> 32X30 Athletic</p>
      </mj-text>
      <mj-text mj-class="light-text" padding="0">
        <p><strong>Color:</strong> Slate Grey</p>
      </mj-text>
      <mj-text mj-class="light-text" padding="0">
        <p><strong>Qty:</strong> 2</p>
      </mj-text>
    </mj-column>
    <mj-column width="25%" vertical-align="bottom">
      <mj-text align="right" padding="0">
        <p>$68.00</p>
      </mj-text>
    </mj-column>
  </mj-section>

  <mj-section padding="10px 0">
    <mj-group>
      <mj-column>
        <mj-text font-size="14px" line-height="20px" padding="5px 0 0 0">
          <p>Discount</p>
          <p>Subtotal</p>
          <p>Tax</p>
        </mj-text>
      </mj-column>
      <mj-column>
        <mj-text font-size="14px" line-height="20px" align="right" padding="5px 0 0">
          <p>$5.00</p>
          <p>$233.00</p>
          <p>$20.00</p>
        </mj-text>
      </mj-column>
    </mj-group>
  </mj-section>

  <mj-section border-top="1px solid #ddd" padding="5px 0">
    <mj-group>
      <mj-column>
        <mj-text padding="5px 0 0 0" font-size="18px" line-height="24px" font-weight="bold">
          <p>Total</p>
        </mj-text>
      </mj-column>
      <mj-column>
        <mj-text
          font-size="18px"
          font-weight="bold"
          line-height="24px"
          align="right"
          padding="5px 0 0"
        >
          <p>$253.00</p>
        </mj-text>
      </mj-column>
    </mj-group>
  </mj-section>
  <mj-section border-top="1px solid #ddd">
    <mj-group>
      <mj-column>
        <mj-text font-size="14px" font-weight="bold" padding="5px 0 0 0" text-transform="uppercase">
          <p>Billing Info</p>
        </mj-text>
        <mj-text font-size="14px" color="#999" line-height="20px" padding="5px 0 0 0">
          <p>
            John Doe<br />
            123 New St <br />
            Alexender Platz, Berlin<br />
            22330<br />
            Germany<br />
          </p>
        </mj-text>
      </mj-column>
      <mj-column>
        <mj-text
          font-size="14px"
          letter-spacing="1px"
          align="right"
          font-size="12px"
          font-weight="bold"
          padding="5px 0 0 0"
          text-transform="uppercase"
        >
          <p>Shipping address</p>
        </mj-text>
        <mj-text font-size="14px" color="#999" align="right" line-height="20px" padding="5px 0 0 0">
          <p>
            John Doe<br />
            123 New St <br />
            Alexender Platz, Berlin<br />
            22330<br />
            Germany<br />
          </p>
        </mj-text>
      </mj-column>
    </mj-group>
  </mj-section>
</mj-wrapper>
    <mj-section background-color="#ffffff" border-radius="0 0 20px 20px">
      <mj-column>
        <mj-text
          >If you have any questions simply reply to this email and we would be more than happy to
          reply. :)</mj-text
        >
      </mj-column>
    </mj-section>
    <mj-section padding-bottom="0px">
  <mj-column>
    <mj-text align="center">
      <a href="#" style="display: inline-block; text-decoration: none">
        <img src="../../../images/google-play.png" alt="play-store-logo" width="150px" />
      </a>
      <a href="#" style="display: inline-block; text-decoration: none">
        <img src="../../../images/app-store.png" alt="app-store-logo" width="150px" />
      </a>
    </mj-text>
  </mj-column>
</mj-section>

<mj-section padding-top="0px">
  <mj-column>
    <mj-text align="center" mj-class="footer-text">
      123 Medalling Jr., Suite 100, Parrot Park, CA 12345<br />
      © 2020 [Coded Mails] Inc.</mj-text
    >
    <mj-text mj-class="footer-text" align="center">
      Update your <a href="https://google.com">email preferences</a> to choose the types of emails
      you receive, or you can <a href="https://google.com"> unsubscribe </a>from all future emails.
    </mj-text>
  </mj-column>
</mj-section>
    <mj-section>
  <mj-column>
    <mj-spacer height="1px"></mj-spacer>
  </mj-column>
</mj-section>
  </mj-body>
</mjml>
