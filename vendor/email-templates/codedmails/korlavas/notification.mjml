<mjml lang="en">
  <mj-head>
    <mj-title>Welcome to Coded Mails</mj-title>
    <mj-preview>Preview - Welcome to Coded Mails</mj-preview>
    <mj-font name="Alata" href="https://fonts.googleapis.com/css2?family=Alata&display=swap" />
    <mj-attributes>
      <mj-button
        text-transform="uppercase"
        font-weight="bold"
        font-size="14px"
        line-height="30px"
        background-color="#ea4a40"
        color="#ffffff"
      ></mj-button>
      <mj-all font-size="14px" line-height="20px" font-family="Alata"></mj-all>
      <mj-text font-weight="400" font-size="18px" color="#000" line-height="24px"></mj-text>
      <mj-class font-weight="bold" name="heading" />
      <mj-class color="#333" name="footer-text" font-size="14px" />
    </mj-attributes>
    <mj-style inline="inline">
      h1,
      h2 {
        margin: 0;
        font-size: 32px;
        line-height: 40px;
      }

      h2 {
        font-size: 24px;
        line-height: 30px;
      }

      h3 {
        margin: 0;
        font-size: 18px;
        line-height: 22px;
      }

      p {
        margin: 0;
      }

      a {
        color: #ea4a40;
        text-decoration: none;
      }

      .date {
        margin-bottom: 5px;
        font-size: 14px;
      }

      .footer-link {
        color: #000;
      }
    </mj-style>
    <mj-style>
      a,
      span,
      td,
      th {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
      }

      .hover:hover td,
      .hover:hover p,
      .hover:hover a {
        background-color: #d9433a !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#ffffff">
    <mj-section padding-bottom="0px">
      <mj-column vertical-align="middle">
        <mj-image
          src="../../../images/logo-black.png"
          alt="image description"
          align="left"
          width="150px"
        />
      </mj-column>
      <mj-column vertical-align="middle">
        <mj-social mode="horizontal" align="right">
          <mj-social-element
            alt="twitter-logo"
            icon-size="18px"
            src="../../../images/social/black/twitter-logo-transparent-black.png"
            href="#"
          ></mj-social-element>
          <mj-social-element
            alt="facebook-logo"
            icon-size="18px"
            src="../../../images/social/black/facebook-logo-transparent-black.png"
            href="#"
          ></mj-social-element>
          <mj-social-element
            alt="instagram-logo"
            icon-size="18px"
            src="../../../images/social/black/instagram-logo-transparent-black.png"
            href="#"
          ></mj-social-element>
          <mj-social-element
            alt="instagram-logo"
            icon-size="18px"
            src="../../../images/social/black/linkedin-logo-transparent-black.png"
            href="#"
          ></mj-social-element>
        </mj-social>
      </mj-column>
    </mj-section>

    <mj-wrapper padding="0 40px">
      <mj-section>
        <mj-column>
          <mj-text>
            <h2>Hi John!</h2>
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="#ea4a40" border-radius="4px">
        <mj-column>
          <mj-text color="#fff" mj-class="heading" align="left">
            <p class="date">ALERT</p>

            <h2>Delivery Cancelled</h2>
          </mj-text>
          <mj-text color="#fff">
            <p>
              Your order could not be completed and has been cancelled. Your account has not been
              charged and we apologize for the inconvenience.
            </p>
          </mj-text>

          <mj-button
            background-color="#fff"
            color="#ea4a40"
            align="right"
            href="https://google.com"
          >
            <strong>more details</strong>
          </mj-button>
        </mj-column>
      </mj-section>

      <mj-section padding="0">
        <mj-column>
          <mj-spacer />
        </mj-column>
      </mj-section>
      <mj-section background-color="#009E3C" border-radius="4px">
        <mj-column>
          <mj-text color="#fff" mj-class="heading" align="left">
            <p class="date">SUCCESS</p>

            <h2>Delivery Complete</h2>
          </mj-text>
          <mj-text color="#fff">
            <p>Your order has been delivered.</p>
          </mj-text>

          <mj-button
            background-color="#fff"
            color="#009E3C"
            align="right"
            href="https://google.com"
          >
            <strong>more details</strong>
          </mj-button>
        </mj-column>
      </mj-section>
      <mj-section padding="0">
        <mj-column>
          <mj-spacer />
        </mj-column>
      </mj-section>
      <mj-section background-color="#008AFF" border-radius="4px">
        <mj-column>
          <mj-text color="#fff" mj-class="heading" align="left">
            <p class="date">INFO</p>

            <h2>Item Dispatched</h2>
          </mj-text>
          <mj-text color="#fff">
            <p>Your item left our warehouse. You should receive it soon.</p>
          </mj-text>

          <mj-button
            background-color="#fff"
            color="#008AFF"
            align="right"
            href="https://google.com"
          >
            <strong>more details</strong>
          </mj-button>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column>
          <mj-text align="left" mj-class="footer-text">
            Have questions or need help? Email us at

            <a href="#"> hello@codedmails.com </a>
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="0px">
  <mj-column>
    <mj-divider border-width="1px" border-color="#f4f4f4" />

    <mj-text align="center" mj-class="footer-text">
      <a class="footer-link" href="#">Support</a> &nbsp; | &nbsp;
      <a class="footer-link" href="#">Forums</a> &nbsp; | &nbsp;<a class="footer-link" href="#"
        >Contact</a
      >
      &nbsp; | &nbsp;<a class="footer-link" href="#">Log In</a>
    </mj-text>

    <mj-social mode="horizontal" align="center">
      <mj-social-element
        alt="twitter-logo"
        icon-size="24px"
        src="../../../images/social/black/twitter-logo-transparent-black.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="facebook-logo"
        icon-size="24px"
        src="../../../images/social/black/facebook-logo-transparent-black.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="instagram-logo"
        icon-size="24px"
        src="../../../images/social/black/instagram-logo-transparent-black.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="dribbble-logo"
        icon-size="24px"
        src="../../../images/social/black/linkedin-logo-transparent-black.png"
        href="#"
      ></mj-social-element>
    </mj-social>

    <mj-text mj-class="footer-text" align="center">
      123 Medalling Jr., Suite 100, Parrot Park, CA 12345<br />
      © 2020 [Coded Mails] Inc.
    </mj-text>
    <mj-text mj-class="footer-text" align="center">
      Update your <a href="https://google.com">email preferences</a> to choose the types of emails
      you receive, or you can <a href="https://google.com"> unsubscribe </a>from all future emails.
    </mj-text>
    <mj-image
      src="../../../images/logo-circle-gray.png"
      alt="image description"
      align="center"
      width="50px"
    />
  </mj-column>
</mj-section>
      <mj-section>
  <mj-column>
    <mj-spacer height="1px"></mj-spacer>
  </mj-column>
</mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
