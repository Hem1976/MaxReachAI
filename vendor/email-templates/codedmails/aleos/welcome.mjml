<mjml lang="en">
  <mj-head>
    <mj-title>Welcome to [Coded Mails]</mj-title>
    <mj-preview>Preview - Welcome to Coded Mails</mj-preview>
    <mj-font
      name="Roboto"
      href="https://fonts.googleapis.com/css?family=Roboto:100,300,400,700"
    ></mj-font>
    <mj-attributes>
      <mj-all font-family="Roboto, Helvetica, Arial, sans-serif"></mj-all>
      <mj-text font-weight="400" font-size="14px" color="#ffffff" line-height="20px"></mj-text>
      <mj-class name="heading" font-weight="400" font-size="24px" line-height="30px" />
      <mj-class name="footer-text" color="#93999f" line-height="20px" />
    </mj-attributes>
    <mj-style inline="inline">
      h1,
      h2 {
        margin: 0;
        font-size: 24px;
        line-height: normal;
        font-weight: normal;
      }

      p {
        margin-bottom: 0;
      }

      a {
        color: #2e58ff;
        text-decoration: none;
      }
    </mj-style>
    <mj-style>
      a,
      span,
      td,
      th {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f3f3f5">
    <mj-section>
      <mj-column>
        <mj-spacer></mj-spacer>
      </mj-column>
    </mj-section>
    <mj-section background-color="#54595f" border-radius="4px 4px 0 0">
      <mj-column>
        <mj-image align="center" width="150px" src="../../../images/logo-white.png"></mj-image>
        <mj-spacer />

        <mj-text mj-class="heading">
          <h1>Welcome to [Coded Mails]</h1>
        </mj-text>

        <mj-text>
          <p>
            Please click the button below to
            <a href="#" style="color: white">complete your registration</a>. Once you have completed
            the process, you can start using our service.
          </p>
        </mj-text>

        <mj-button
          line-height="30px"
          align="center"
          href="https://google.com"
          background-color="#2e58ff"
          color="white"
        >
          Complete your registration
        </mj-button>

        <mj-text>
          <p>
            If you have any questions simply reply to this email and we would be more than happy to
            reply. Looking forward to see you using our service.
          </p>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section background-color="#fff" border-radius="0 0 4px 4px">
  <mj-column>
    <mj-text mj-class="footer-text" align="center">
      © 2020 [Coded Mails] GmbH, All rights reserved
      <br />
      Email: <a class="footer-link" href="#">support@codedmails.com</a> <br />
      Web: <a class="footer-link" href="#">www.codedmails.com</a>
    </mj-text>
    <mj-social mode="horizontal" align="center">
      <mj-social-element
        alt="twitter-logo"
        icon-size="24px"
        src="../../../images/social/color/twitter-logo-transparent.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="facebook-logo"
        icon-size="24px"
        src="../../../images/social/color/facebook-logo-transparent.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="instagram-logo"
        icon-size="24px"
        src="../../../images/social/color/insta-logo-transparent.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="youtube-logo"
        icon-size="24px"
        src="../../../images/social/color/youtube-logo-transparent.png"
        href="#"
      ></mj-social-element>
    </mj-social>
  </mj-column>
</mj-section>
    <mj-section>
  <mj-column>
    <mj-spacer height="1px"></mj-spacer>
  </mj-column>
</mj-section>
  </mj-body>
</mjml>
