<mjml lang="en">
  <mj-head>
    <mj-title>Newsletter [Coded Mails]</mj-title>
    <mj-preview>Preview - Newsletter from Coded Mails</mj-preview>
    <mj-font
      name="Roboto"
      href="https://fonts.googleapis.com/css?family=Roboto:100,300,400,700"
    ></mj-font>
    <mj-attributes>
      <mj-all font-family="Roboto, Helvetica, Arial, sans-serif"></mj-all>
      <mj-text font-weight="400" font-size="14px" color="#ffffff" line-height="20px"></mj-text>
      <mj-class name="heading" font-weight="500" font-size="24px" line-height="30px" />
      <mj-class name="footer-text" color="#93999f" line-height="20px" />
    </mj-attributes>
    <mj-style inline="inline">
      h1,
      h2,
      h3 {
        margin: 0;
        font-size: 24px;
        line-height: normal;
        font-weight: 400;
      }

      h2 {
        font-size: 20px;
        font-weight: 300;
      }

      h3 {
        font-size: 16px;
        font-weight: 400;
      }

      p {
        margin: 0;
      }

      .footer-link {
        color: #2e58ff;
        text-decoration: none;
      }

      a {
        color: #fff;
        text-decoration: underline;
      }

      .date {
        margin-bottom: 5px;
        font-size: 16px;
      }
    </mj-style>
    <mj-style>
      a,
      span,
      td,
      th {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f3f3f5">
    <mj-section>
      <mj-column>
        <mj-spacer></mj-spacer>
      </mj-column>
    </mj-section>
    <mj-wrapper background-color="#54595f" border-radius="4px 4px 0 0" padding-bottom="0px">
      <mj-section padding="0px">
        <mj-column>
          <mj-image align="center" width="150px" src="../../../images/logo-white.png"></mj-image>

          <mj-text mj-class="heading" align="center">
            <h1>From Codedmails Community</h1>
          </mj-text>

          <mj-divider border-color="#999" border-width="1px" />
        </mj-column>
      </mj-section>

      <mj-section padding-top="0">
        <mj-column>
          <mj-image
            src="https://images.unsplash.com/photo-1509774251289-92e35f5f03ec?ixlib=rb-1.2.1&ixid=eyJhcHBfaWQiOjEyMDd9&auto=format&fit=crop&w=2250&q=80"
            alt="image description"
          />
          <mj-text mj-class="heading" align="left">
            <h1>Triple bottom line milestones emerging leverage cultivate</h1>
          </mj-text>
          <mj-text>
            <p>
              B-corp issue outcomes, blended value do-gooder social intrapreneurship catalyze.
              Outcomes inclusive social entrepreneur, save the world B-corp or venture philanthropy
              a but.
            </p>
          </mj-text>

          <mj-button
            align="left"
            font-size="14px"
            line-height="24px"
            href="https://google.com"
            background-color="#2e58ff"
            color="white"
          >
            <strong>Read more</strong>
          </mj-button>
        </mj-column>
      </mj-section>

      <mj-section background-color="#34393E">
        <mj-column>
          <mj-text mj-class="heading" align="center">
            <h1>Weekly trending topics</h1>
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column>
          <mj-text mj-class="heading" align="left">
            <p class="date">Janurary 12, 2020</p>

            <h2>Targeted progress, innovation entrepreneur catalyze equal opportunity.</h2>
          </mj-text>

          <mj-text>
            <p>
              Social return on investment unprecedented challenge, gender rights venture
              philanthropy incubator resilient co-creation youth.
            </p>
          </mj-text>

          <mj-button
            align="left"
            font-size="14px"
            line-height="24px"
            href="https://google.com"
            background-color="#2e58ff"
            color="white"
          >
            <strong>Read more</strong>
          </mj-button>
        </mj-column>
      </mj-section>
      <mj-section background-color="#34393E">
        <mj-column>
          <mj-text mj-class="heading" align="left">
            <p class="date">Janurary 13, 2020</p>

            <h2>Peaceful, a, social enterprise; inspiring support, shared value fairness.</h2>
          </mj-text>
          <mj-text>
            <p>
              B-corp issue outcomes, blended value do-gooder social intrapreneurship catalyze.
              Outcomes inclusive social entrepreneur, save the world B-corp or venture philanthropy
              a but.
            </p>
          </mj-text>

          <mj-button
            align="left"
            font-size="14px"
            line-height="24px"
            href="https://google.com"
            background-color="#2e58ff"
            color="white"
          >
            <strong>Read more</strong>
          </mj-button>
        </mj-column>
      </mj-section>

      <mj-section>
        <mj-column>
          <mj-text>
            <h3>
              We hope you find these resources helpful, and we’ll be in touch again next week with
              more updates.
            </h3>
          </mj-text>
          <mj-text>
            <p>
              If you don’t wish to recieve these e-mails,
              <a href="#">unsubscribe here.</a>
            </p>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section background-color="#fff" border-radius="0 0 4px 4px">
  <mj-column>
    <mj-text mj-class="footer-text" align="center">
      © 2020 [Coded Mails] GmbH, All rights reserved
      <br />
      Email: <a class="footer-link" href="#">support@codedmails.com</a> <br />
      Web: <a class="footer-link" href="#">www.codedmails.com</a>
    </mj-text>
    <mj-social mode="horizontal" align="center">
      <mj-social-element
        alt="twitter-logo"
        icon-size="24px"
        src="../../../images/social/color/twitter-logo-transparent.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="facebook-logo"
        icon-size="24px"
        src="../../../images/social/color/facebook-logo-transparent.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="instagram-logo"
        icon-size="24px"
        src="../../../images/social/color/insta-logo-transparent.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="youtube-logo"
        icon-size="24px"
        src="../../../images/social/color/youtube-logo-transparent.png"
        href="#"
      ></mj-social-element>
    </mj-social>
  </mj-column>
</mj-section>
    <mj-section>
  <mj-column>
    <mj-spacer height="1px"></mj-spacer>
  </mj-column>
</mj-section>
  </mj-body>
</mjml>
