<mjml lang="en">
  <mj-head>
    <mj-title>Notificatin [Coded Mails]</mj-title>
    <mj-preview>Preview - Notification from Coded Mails</mj-preview>
    <mj-font
      name="Roboto"
      href="https://fonts.googleapis.com/css?family=Roboto:400,500,700"
    ></mj-font>
    <mj-attributes>
      <mj-all font-family="Roboto, Helvetica, Arial, sans-serif"></mj-all>
      <mj-text font-weight="400" font-size="14px" color="#ffffff" line-height="20px"></mj-text>
      <mj-class name="heading" font-weight="400" font-size="24px" line-height="30px" />
      <mj-class name="footer-text" color="#93999f" line-height="20px" />
      <mj-class name="light-text" color="#aaa" line-height="20px" />
      <mj-class
        name="button"
        font-size="14px"
        line-height="20px"
        href="https://google.com"
        background-color="#2e58ff"
        color="white"
      />
    </mj-attributes>
    <mj-style inline="inline">
      h1,
      h2 {
        margin: 0;
        font-size: 24px;
        line-height: normal;
        font-weight: 400;
      }

      .receipt-table th {
        text-align: left;
        font-size: 20px;
        line-height: 30px;
        font-weight: 500;
        color: #fff;
        padding: 0px 0px 10px 0px;
      }

      .receipt-table td {
        color: #ccc;
        font-size: 15px;
        line-height: 22px;
        font-weight: 400;
        word-break: normal;
      }

      p {
        margin: 0;
      }

      a {
        color: #009bf9;
        text-decoration: none;
        word-break: normal;
      }
    </mj-style>
    <mj-style>
      a,
      span,
      td,
      th {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f3f3f5">
    <mj-section>
      <mj-column>
        <mj-spacer></mj-spacer>
      </mj-column>
    </mj-section>
    <mj-wrapper background-color="#54595f" border-radius="4px 4px 0 0">
      <mj-section padding="0px">
        <mj-column>
          <mj-image align="center" width="150px" src="../../../images/logo-white.png"></mj-image>
          <mj-spacer />

          <mj-text mj-class="heading" align="center" padding-bottom="0px">
            <h1>Thank you for your order</h1>
          </mj-text>
          <mj-text mj-class="light-text" align="center" padding-top="0">
            <p>Order Number:234234234 | Order Date: 03-13-2020</p>
          </mj-text>
          <mj-divider border-color="#999" border-width="1px" />

          <mj-text>
            <p>
              Hi John Doe,<br />
              Thank you for your purchase. Please find your order summary below.
            </p>
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column inner-background-color="#34393E" padding="0px 25px">
          <mj-table padding="30px" css-class="receipt-table">
  <tr>
    <th colspan="3" style="text-align: center; border-bottom: 1px solid #555">Order summary</th>
  </tr>
  <tr>
    <td style="width: 60%; padding-top: 10px">Product with a longer name</td>
    <td style="text-align: right; width: 20%">2</td>
    <td style="text-align: right; width: 20%">€19.00</td>
  </tr>
  <tr>
    <td>The Second Product</td>
    <td style="text-align: right; padding: 0 0 10px">1</td>
    <td style="text-align: right; padding: 0 0 10px">€10.02</td>
  </tr>
  <tr>
    <td
      style="
        border-bottom-width: 1px;
        border-bottom-color: #555;
        border-bottom-style: solid;
        padding-top: 10px;
      "
    ></td>
    <td
      style="
        border-bottom-width: 1px;
        border-bottom-color: #555;
        border-bottom-style: solid;
        padding-top: 10px;
      "
    ></td>
    <td
      style="
        border-bottom-width: 1px;
        border-bottom-color: #555;
        border-bottom-style: solid;
        padding-top: 10px;
      "
    ></td>
  </tr>
  <tr>
    <td style="padding: 10px 0; text-align: left" colspan="2">VAT</td>
    <td style="padding: 10px 0; text-align: right">€0</td>
  </tr>
  <tr>
    <td
      style="
        color: #fff;
        font-size: 20px;
        line-height: 30px;
        border-top: 1px solid #555;
        font-weight: 500;
        padding: 10px 0px 0px 0px;
        text-align: left;
      "
      colspan="2"
    >
      Total
    </td>
    <td
      style="
        color: #fff;
        font-size: 20px;
        line-height: 30px;
        border-top: 1px solid #555;
        font-weight: 500;
        text-align: right;
        padding: 10px 0px 0px 0px;
      "
    >
      €29.02
    </td>
  </tr>
</mj-table>
        </mj-column>
      </mj-section>

      <mj-section padding="0px">
        <mj-group>
          <mj-column width="50%">
            <mj-button mj-class="button" align="left"> Download Receipt </mj-button>
          </mj-column>
          <mj-column width="50%">
            <mj-button mj-class="button" align="right" background-color="#72787E">
              Track your order
            </mj-button>
          </mj-column>
          <mj-column width="100%">
            <mj-text align="left">
              <p>
                You're receiving this email because you made a purchase at Coded Mails. If you have
                any questions, contact us at
                <a href="#">help@codedmails.com</a>
              </p>
            </mj-text>
          </mj-column>
        </mj-group>
      </mj-section>
    </mj-wrapper>

    <mj-section background-color="#fff" border-radius="0 0 4px 4px">
  <mj-column>
    <mj-text mj-class="footer-text" align="center">
      © 2020 [Coded Mails] GmbH, All rights reserved
      <br />
      Email: <a class="footer-link" href="#">support@codedmails.com</a> <br />
      Web: <a class="footer-link" href="#">www.codedmails.com</a>
    </mj-text>
    <mj-social mode="horizontal" align="center">
      <mj-social-element
        alt="twitter-logo"
        icon-size="24px"
        src="../../../images/social/color/twitter-logo-transparent.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="facebook-logo"
        icon-size="24px"
        src="../../../images/social/color/facebook-logo-transparent.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="instagram-logo"
        icon-size="24px"
        src="../../../images/social/color/insta-logo-transparent.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="youtube-logo"
        icon-size="24px"
        src="../../../images/social/color/youtube-logo-transparent.png"
        href="#"
      ></mj-social-element>
    </mj-social>
  </mj-column>
</mj-section>
    <mj-section>
  <mj-column>
    <mj-spacer height="1px"></mj-spacer>
  </mj-column>
</mj-section>
  </mj-body>
</mjml>
