<mjml lang="en">
  <mj-head>
    <mj-title>Notificatin [Coded Mails]</mj-title>
    <mj-preview>Preview - Notification from Coded Mails</mj-preview>
    <mj-font
      name="Roboto"
      href="https://fonts.googleapis.com/css?family=Roboto:100,300,400,700"
    ></mj-font>
    <mj-attributes>
      <mj-all font-family="Roboto, Helvetica, Arial, sans-serif"></mj-all>
      <mj-text font-weight="400" font-size="14px" color="#ffffff" line-height="20px"></mj-text>
      <mj-class name="heading" font-weight="400" font-size="24px" line-height="30px" />
      <mj-class name="footer-text" color="#93999f" line-height="20px" />
    </mj-attributes>
    <mj-style inline="inline">
      h1,
      h2 {
        margin: 0;
        font-size: 24px;
        line-height: normal;
        font-weight: 400;
      }

      p {
        margin: 0;
      }

      a {
        color: #2e58ff;
        text-decoration: none;
      }
    </mj-style>
    <mj-style>
      a,
      span,
      td,
      th {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f3f3f5">
    <mj-section>
      <mj-column>
        <mj-spacer></mj-spacer>
      </mj-column>
    </mj-section>
    <mj-wrapper background-color="#54595f" border-radius="4px 4px 0 0">
      <mj-section padding="0px">
        <mj-column>
          <mj-image align="center" width="150px" src="../../../images/logo-white.png"></mj-image>
          <mj-spacer />

          <mj-image
            src="https://img.icons8.com/color/96/000000/error.png"
            width="64px"
            alt="alert icon"
          />

          <mj-text mj-class="heading" align="center">
            <h1>Did you log in from a new device?</h1>
          </mj-text>

          <mj-text>
            <p>
              We noticed your [Coded Mails] account was logged into from a new device. If this was
              you, you can safely disregard this email.
            </p>
          </mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="10px 20px">
        <mj-column
          width="100%"
          border-radius="3px 3px 0px 0px"
          padding="10px 0"
          background-color="#5f646c"
        >
          <mj-text font-size="16px" color="#fff">
            <p><strong>When:</strong> Sun, Aug 4, 2019, 11:40 AM EDT</p>
          </mj-text>
          <mj-text font-size="16px" color="#fff">
            <p><strong>Where:</strong> California, United States</p>
          </mj-text>
          <mj-text font-size="16px" color="#fff">
            <p><strong>Device:</strong> Firefox using Mac</p>
          </mj-text>
        </mj-column>
        <mj-column
          width="100%"
          border-radius="0px 0px 3px 3px"
          padding="10px 0px"
          background-color="#5f646c"
        >
          <mj-divider border-width="1px" border-style="dashed" border-color="lightgrey" />

          <mj-button
            font-size="14px"
            line-height="32px"
            href="https://google.com"
            background-color="#2e58ff"
            color="white"
          >
            <strong>It wasn't you?</strong> Review your Account
          </mj-button>
        </mj-column>
      </mj-section>
      <mj-section>
        <mj-column>
          <mj-text
            >If you have any questions simply reply to this email and we would be more than happy to
            reply. :)</mj-text
          >
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section background-color="#fff" border-radius="0 0 4px 4px">
  <mj-column>
    <mj-text mj-class="footer-text" align="center">
      © 2020 [Coded Mails] GmbH, All rights reserved
      <br />
      Email: <a class="footer-link" href="#">support@codedmails.com</a> <br />
      Web: <a class="footer-link" href="#">www.codedmails.com</a>
    </mj-text>
    <mj-social mode="horizontal" align="center">
      <mj-social-element
        alt="twitter-logo"
        icon-size="24px"
        src="../../../images/social/color/twitter-logo-transparent.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="facebook-logo"
        icon-size="24px"
        src="../../../images/social/color/facebook-logo-transparent.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="instagram-logo"
        icon-size="24px"
        src="../../../images/social/color/insta-logo-transparent.png"
        href="#"
      ></mj-social-element>
      <mj-social-element
        alt="youtube-logo"
        icon-size="24px"
        src="../../../images/social/color/youtube-logo-transparent.png"
        href="#"
      ></mj-social-element>
    </mj-social>
  </mj-column>
</mj-section>
    <mj-section>
  <mj-column>
    <mj-spacer height="1px"></mj-spacer>
  </mj-column>
</mj-section>
  </mj-body>
</mjml>
